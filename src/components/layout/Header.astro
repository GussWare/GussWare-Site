---
/**
 * Header — Maquetación fiel al diseño Stitch (GussWare Home - Complete Final Flow).
 * Logo y menú principal dinámicos desde WordPress REST API vía
 * `src/lib/wordpress` (este componente no llama a WordPress directamente).
 * Reutiliza tokens existentes: colores, tipografía navigation/label-bold,
 * espaciados y layout (container-max, gutter), shape rectilinear.
 * Responsive solo visual (sin JS): nav completa en lg+, hamburger visual
 * en Tablet/Mobile, CTA visible desde sm.
 * El botón hamburguesa abre/cierra el panel móvil con los mismos ítems
 * de WordPress (único JS del componente, sin framework).
 */
import { getHeaderLogo } from '../../lib/wordpress/logo';
import { getHeaderMenu } from '../../lib/wordpress/menu';
import Button from '../ui/Button.astro';

const [logo, menuItems] = await Promise.all([getHeaderLogo(), getHeaderMenu()]);
const topLevelItems = menuItems.filter((item) => item.parent === 0);
---

<header class="bg-gw-surface-primary sticky top-0 z-50 w-full border-b border-gw-border-subtle">
  <div class="mx-auto flex h-16 w-full max-w-[var(--container-max)] items-center justify-between px-4 md:px-6">
    <!-- Logo -->
    <a
      href="/"
      aria-label="GussWare Home"
      class="flex items-center gap-2 rounded focus:outline-none"
    >
      {logo ? (
        <img src={logo.src} alt={logo.alt} class="block h-8 w-auto" />
      ) : (
        <span class="text-label-bold text-gw-text-secondary">GussWare</span>
      )}
    </a>

    <!-- Desktop Navigation (visible desde lg; en Tablet/Mobile la oculta el hamburger visual) -->
    <nav
      aria-label="Main Navigation"
      class="hidden items-center gap-6 lg:flex xl:gap-8"
    >
      {topLevelItems.map((item) => (
        <a
          href={item.url}
          target={item.target || undefined}
          class="text-navigation text-gw-text-secondary transition-colors duration-200 hover:text-brand-secondary"
        >
          {item.title}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <Button href="/contact" variant="primary" class="hidden sm:inline-flex">
        Start a Conversation
      </Button>

      <button
        type="button"
        id="header-menu-toggle"
        aria-expanded="false"
        aria-controls="header-mobile-menu"
        aria-label="Menú"
        class="text-gw-text-secondary p-2 lg:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation (Tablet/Mobile; la abre el botón hamburguesa) -->
  <div
    id="header-mobile-menu"
    class="border-gw-border-subtle bg-gw-surface-primary hidden border-t lg:hidden"
  >
    <nav
      aria-label="Mobile Navigation"
      class="mx-auto flex w-full max-w-[var(--container-max)] flex-col px-4 py-2 md:px-6"
    >
      {topLevelItems.map((item) => (
        <a
          href={item.url}
          target={item.target || undefined}
          class="text-navigation text-gw-text-secondary py-3 transition-colors duration-200 hover:text-brand-secondary"
        >
          {item.title}
        </a>
      ))}
      <Button href="/contact" variant="primary" class="mt-2 flex md:hidden">
        Start a Conversation
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('header-menu-toggle');
  const menu = document.getElementById('header-mobile-menu');

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
