---
/**
 * Header — Maquetación fiel al diseño Stitch (GussWare Home - Complete Final Flow).
 * Logo y menú principal dinámicos desde WordPress REST API vía
 * `src/lib/wordpress` (este componente no llama a WordPress directamente).
 * Reutiliza tokens existentes: colores, tipografía navigation/label-bold,
 * espaciados y layout (container-max, gutter), shape rectilinear.
 * Responsive solo visual (sin JS): nav completa en lg+, hamburger visual
 * en Tablet/Mobile, CTA visible desde sm.
 * El botón hamburguesa abre/cierra el panel móvil con los mismos ítems
 * de WordPress; dentro del panel, cada padre con hijos lleva su botón
 * expansor (acordeón). JS vainilla del componente, sin framework.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getHeaderLogo } from '../../lib/wordpress/logo';
import {
  buildMenuTree,
  getHeaderMenu,
  resolveMenuTreeHrefs,
} from '../../lib/wordpress/menu';
import type { ResolvedMenuTreeItem } from '../../lib/wordpress/menu';
import { getHeader } from '../../lib/wordpress/header';
import { routes } from '../../lib/routes';
import type { LocaleUrls } from '../../lib/routes';
import Button from '../ui/Button.astro';
import DesktopMenuNodes from './DesktopMenuNodes.astro';
import LanguageSelector from '../ui/LanguageSelector.astro';
import Logo from '../ui/Logo.astro';
import MenuButton from '../ui/MenuButton.astro';
import MobileMenuNodes from './MobileMenuNodes.astro';

interface Props {
  localeUrls?: LocaleUrls;
}

const { localeUrls = undefined } = Astro.props;

const [logo, menuItems, header] = await Promise.all([
  getHeaderLogo(),
  getHeaderMenu(Astro.currentLocale ?? undefined),
  getHeader(Astro.currentLocale ?? undefined),
]);
const menuTree = buildMenuTree(menuItems);
// RGW-273 — Resolución inteligente del `href` según el tipo de enlace
// de WordPress (ancla, ruta interna o URL completa), por página e idioma,
// en todo el árbol. Solo cambia el destino; estructura y estilos intactos.
const locale = Astro.currentLocale ?? 'es';
const homePath = locale === 'en' ? getRelativeLocaleUrl('en', '/') : routes.home;
const navItems: ResolvedMenuTreeItem[] = resolveMenuTreeHrefs(menuTree, {
  currentPath: Astro.url.pathname,
  homePath,
  currentOrigin: Astro.url.origin,
});
const desktopLogo = header?.logo ?? logo;
const mobileLogo = header?.mobileLogo ?? desktopLogo;
---

<header class="bg-gw-surface-primary sticky top-0 z-50 w-full border-b border-gw-border-subtle">
  <div class="mx-auto flex h-16 w-full max-w-[var(--container-max)] items-center justify-between px-4 md:px-6">
    <!-- Logo: logo_section.logo en >=425px (fluido, sin overflow), logo_section.mobile_logo solo en <425px -->
    <Logo
      src={desktopLogo?.src}
      alt={desktopLogo?.alt}
      class="hidden min-w-0 min-[425px]:flex [&_img]:h-auto [&_img]:max-h-8 [&_img]:max-w-full"
    />
    <Logo
      src={mobileLogo?.src}
      alt={mobileLogo?.alt}
      class="min-[425px]:hidden"
    />

    <!-- Desktop Navigation (visible desde lg; en Tablet/Mobile la oculta el hamburger visual) -->
    <!-- RGW-273 — Submenú recursivo (`DesktopMenuNodes`): N niveles sin
      límite, desplegable CSS con hover + focus-within (teclado), sin JS.
      El enlace padre conserva su URL de WordPress. -->
    <nav
      aria-label="Main Navigation"
      class="hidden items-center gap-6 lg:flex xl:gap-8"
    >
      <DesktopMenuNodes nodes={navItems} />
    </nav>

    <!-- Desktop CTA & Mobile Toggle -->
    <div class="flex items-center gap-4">
      <LanguageSelector localeUrls={localeUrls} />
      {header?.status && (
        <Button
          href={header.url}
          variant="primary"
          class="hidden sm:inline-flex"
        >
          {header.button_text}
        </Button>
      )}

      <MenuButton
        id="header-menu-toggle"
        expanded={false}
        controls="header-mobile-menu"
        label="Menú"
        class="text-gw-text-secondary p-2 lg:hidden"
      />
    </div>
  </div>

  <!-- Mobile Navigation (Tablet/Mobile; la abre el botón hamburguesa) -->
  <div
    id="header-mobile-menu"
    class="border-gw-border-subtle bg-gw-surface-primary hidden border-t lg:hidden"
  >
    <nav
      aria-label="Mobile Navigation"
      class="mx-auto flex w-full max-w-[var(--container-max)] flex-col px-4 py-2 md:px-6"
    >
      {/* RGW-273 — Submenú móvil recursivo (`MobileMenuNodes`): N niveles
        sin límite, acordeón por nivel con el JS del componente. */}
      <MobileMenuNodes nodes={navItems} />
      <LanguageSelector variant="panel" localeUrls={localeUrls} />
      <Button
        href={routes.contact}
        variant="primary"
        class="mt-2 flex md:hidden"
      >
        Start a Conversation
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('header-menu-toggle');
  const menu = document.getElementById('header-mobile-menu');

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // RGW-273 — Acordeón de submenús (solo < lg, sin hover): cada botón
    // expande su propio panel sin interferir con el resto ni con los
    // enlaces, que conservan su navegación.
    menu.querySelectorAll('[data-submenu-toggle]').forEach((toggleBtn) => {
      if (!(toggleBtn instanceof HTMLButtonElement)) return;

      toggleBtn.addEventListener('click', () => {
        const panel = toggleBtn.parentElement?.nextElementSibling;

        if (!(panel instanceof HTMLElement)) return;

        const willOpen = panel.classList.contains('hidden');
        panel.classList.toggle('hidden', !willOpen);
        panel.classList.toggle('flex', willOpen);
        toggleBtn.setAttribute('aria-expanded', String(willOpen));

        const chevron = toggleBtn.querySelector('svg');

        if (chevron instanceof SVGElement) {
          chevron.classList.toggle('rotate-[270deg]', willOpen);
        }
      });
    });
  }
</script>
