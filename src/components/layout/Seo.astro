---
/**
 * SEO genérico reutilizable (una sola implementación para todas las
 * páginas): renderiza en `<head>` los metadatos de `yoast_head_json`
 * con el idioma de Polylang (`lang`, `translations`). Tolera
 * propiedades opcionales ausentes sin inventar valores.
 */
import {
  fixSchemaLocales,
  resolveHreflang,
  resolveOgLocale,
  serializeRobots,
} from '../../lib/seo';
import type { SeoData } from '../../lib/seo';

interface Props extends SeoData {}

const {
  lang,
  yoast = null,
  alternateUrls = {},
  languages = null,
} = Astro.props;

const robots = serializeRobots(yoast?.robots);
const ogImage = Array.isArray(yoast?.og_image)
  ? (yoast?.og_image[0]?.url ?? undefined)
  : undefined;
const schema = yoast?.schema ? fixSchemaLocales(yoast.schema, lang) : undefined;
---

{yoast?.title && <title>{yoast.title}</title>}
{yoast?.description && <meta name="description" content={yoast.description} />}
{yoast?.canonical && <link rel="canonical" href={yoast.canonical} />}
{robots && <meta name="robots" content={robots} />}
<meta property="og:locale" content={resolveOgLocale(lang, languages)} />
{yoast?.og_type && <meta property="og:type" content={yoast.og_type} />}
{yoast?.og_title && <meta property="og:title" content={yoast.og_title} />}
{yoast?.og_description && (
  <meta property="og:description" content={yoast.og_description} />
)}
{yoast?.og_url && <meta property="og:url" content={yoast.og_url} />}
{yoast?.og_site_name && (
  <meta property="og:site_name" content={yoast.og_site_name} />
)}
{ogImage && <meta property="og:image" content={ogImage} />}
{yoast?.twitter_card && (
  <meta name="twitter:card" content={yoast.twitter_card} />
)}
{yoast?.twitter_title && (
  <meta name="twitter:title" content={yoast.twitter_title} />
)}
{yoast?.twitter_description && (
  <meta name="twitter:description" content={yoast.twitter_description} />
)}
{yoast?.twitter_image && (
  <meta name="twitter:image" content={yoast.twitter_image} />
)}
{Object.entries(alternateUrls).map(([locale, href]) => (
  <link
    rel="alternate"
    hreflang={resolveHreflang(locale, languages)}
    href={href}
  />
))}
{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
)}
