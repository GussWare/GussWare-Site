---
/**
 * RGW-273 — Nodo de navegación desktop (recursivo con
 * `DesktopMenuNodes`: N niveles sin límite impuesto por Astro).
 *
 * RGW-295 — Paridad visual desktop con Stitch (GussWare Home-V0.2.0):
 * tipografía `text-navigation` (15/600/20, token Stitch), color de
 * hover `brand-secondary` y elevación por capas tonales sin sombras
 * (el sistema Stitch evita sombras tradicionales). Las filas del
 * submenu son bloques de ancho completo con padding y fondo tonal en
 * hover/focus; el foco de teclado usa el anillo del proyecto
 * (`focus-visible:ring-supporting-blue-dark`, patrón de Button/Link).
 * Solo desktop: este componente no se renderiza en Tablet/Mobile.
 *
 * - El desplegable de nivel 0 abre debajo del menú principal.
 * - Los paneles anidados (depth ≥ 1) abren lateralmente alineados con
 *   la parte superior de su fila padre exacta (`top-0` relativo al
 *   nodo), nunca con la parte superior del contenedor del submenú.
 * - La dirección lateral (derecha/izquierda) la decide JS por nivel
 *   según el espacio del viewport (`flyout-left`); ver script del
 *   Header. Sin niveles fijos: vale para cualquier profundidad.
 * - Apertura por padre directo (hover/focus con combinador hijo).
 * - RGW-295 (Ciclo 1) — Indicador por nivel: depth 0 apunta hacia
 *   abajo; depth ≥ 1 apunta hacia la derecha.
 * - RGW-295 (Ciclo 2) — La flecha de depth 0 hace un nudge sutil hacia
 *   abajo en cada hover (0.3s, sin rotar); el resto permanece estático.
 * El enlace padre conserva su URL de WordPress.
 */
import DesktopMenuNodes from './DesktopMenuNodes.astro';
import Icon from '../ui/Icon.astro';
import { menuItemClasses } from '../../lib/wordpress/menu';
import type { ResolvedMenuTreeItem } from '../../lib/wordpress/menu';

interface Props {
  node: ResolvedMenuTreeItem;
  depth?: number;
}

const { node: item, depth = 0 } = Astro.props;
const hasChildren = item.children.length > 0;
const isNestedFlyout = depth > 0;
---

<style>
  /* RGW-273 — Apertura por padre directo: `:hover`/`:focus-within`
     con combinador hijo para que los descendientes no se abran con el
     ancestro (ver `DesktopMenuNodes`). Con ámbito del componente. */
  [data-desktop-node]:hover > [data-desktop-panel],
  [data-desktop-node]:focus-within > [data-desktop-panel] {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  [data-desktop-panel] {
    min-width: 14rem;
  }

  /* RGW-295 (Ciclo 2) — Nudge sutil de la flecha de items principales
     con hijos: en cada hover baja 2px y regresa a su posición, sin
     girar ni cambiar de dirección (solo `translateY`). Solo depth 0 y
     solo con `no-preference` de movimiento reducido. */
  @keyframes gw-desktop-chevron-nudge {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(2px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-desktop-node][data-depth='0']:hover > a > [data-desktop-chevron] {
      animation: gw-desktop-chevron-nudge 0.3s ease-in-out;
    }
  }

  /* RGW-273 — Flyout hacia la izquierda (lo activa JS por nivel cuando
     el panel no cabe a la derecha del viewport). */
  [data-desktop-node].flyout-left > [data-desktop-panel] {
    left: auto;
    right: 100%;
    padding-left: 0;
    padding-right: 0.5rem;
  }

  /* RGW-273 — Contención vertical: si al abrir lateralmente el panel no
     cabe debajo del viewport, se ancla al borde inferior del nodo (abre
     hacia arriba), manteniendo el anclaje al padre exacto. No afecta al
     nivel 0 (depth=0 abre siempre debajo y el JS no toca ese nodo). */
  [data-desktop-node].flyout-up > [data-desktop-panel] {
    top: auto;
    bottom: 0;
  }
</style>

{!hasChildren ? (
  <a
    href={item.href}
    target={item.target || undefined}
    title={item.attrTitle || undefined}
    rel={item.rel || undefined}
    class={`text-navigation text-gw-text-secondary transition-colors duration-200 hover:text-brand-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark${isNestedFlyout ? ' block w-full px-3 py-2 hover:bg-gw-surface-secondary' : ' py-2'}${menuItemClasses(item)}`}
  >
    {item.title}
  </a>
) : (
  <div class="relative" data-desktop-node data-depth={depth}>
    <a
      href={item.href}
      target={item.target || undefined}
      title={item.attrTitle || undefined}
      rel={item.rel || undefined}
      aria-haspopup="true"
      class={`text-navigation text-gw-text-secondary flex items-center gap-1 transition-colors duration-200 hover:text-brand-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark${isNestedFlyout ? ' w-full px-3 py-2 hover:bg-gw-surface-secondary' : ' py-2'}${menuItemClasses(item)}`}
    >
      {item.title}
      {hasChildren && (
        /* RGW-295 (Ciclo 1, obs 1-3; Ciclo 2) — Indicador data-driven
           según nivel: nivel 0 apunta hacia abajo (`rotate-90` estático
           sobre el `chevron-right` existente, sin crear iconos);
           niveles anidados apuntan hacia la derecha. El `span`
           (elemento propio del componente) permite animar solo la
           flecha sin pelear con el scope del `svg` de `Icon`. */
        <span data-desktop-chevron class="ml-auto inline-flex shrink-0">
          <Icon
            name="chevron-right"
            size={4}
            class={isNestedFlyout ? '' : 'rotate-90'}
          />
        </span>
      )}
    </a>
    <div
      data-desktop-panel
      class={`invisible absolute z-50${isNestedFlyout ? ' left-full top-0' : ' left-0 top-full translate-y-1'} pt-2 opacity-0 transition-[opacity,transform,visibility] duration-200 ease-out`}
    >
      {/* RGW-295 — Sin sombra: el sistema Stitch comunica elevación
        con capas tonales y borde 1px, no con sombras (ver `Card.astro`,
        `Expertise.astro`).
        Ciclo 1, obs 4 — Sin padding horizontal en el contenedor para que
        el fondo de hover de cada fila ocupe todo el ancho del submenu;
        las filas conservan su propio `px-3` para el inset del texto. */}
      <div class="bg-gw-surface-primary border-gw-border-subtle flex flex-col gap-1 border px-0 py-2">
        <DesktopMenuNodes nodes={item.children} depth={depth + 1} />
      </div>
    </div>
  </div>
)}
