---
/**
 * RGW-273 — Nodo de navegación desktop (recursivo con
 * `DesktopMenuNodes`: N niveles sin límite impuesto por Astro).
 *
 * Desplegable CSS sin JS. Cada panel abre SOLO con hover/focus de SU
 * nodo padre directo (`:hover >` y `:focus-within >` por combinador
 * hijo en el `<style>`): los descendientes nunca se abren con el
 * ancestro (los `group-hover` genéricos sí filtraban hacia abajo).
 * Teclado: el foco dentro mantiene abierta su rama. Apertura con
 * transición sutil (opacidad + desplazamiento mínimo).
 * El enlace padre conserva su URL de WordPress.
 * Flecha solo en elementos de submenú (depth ≥ 1) con hijos, alineada
 * al extremo derecho; el nivel principal no la muestra.
 */
import DesktopMenuNodes from './DesktopMenuNodes.astro';
import Icon from '../ui/Icon.astro';
import { menuItemClasses } from '../../lib/wordpress/menu';
import type { ResolvedMenuTreeItem } from '../../lib/wordpress/menu';

interface Props {
  node: ResolvedMenuTreeItem;
  depth?: number;
}

const { node: item, depth = 0 } = Astro.props;
const hasChildren = item.children.length > 0;
const isSubmenuMember = depth > 0;
---

<style>
  /* RGW-273 — Apertura por padre directo: `:hover`/`:focus-within`
     con combinador hijo para que los descendientes no se abran con el
     ancestro (ver `DesktopMenuNodes`). Con ámbito del componente. */
  [data-desktop-node]:hover > [data-desktop-panel],
  [data-desktop-node]:focus-within > [data-desktop-panel] {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  [data-desktop-node]:hover > a > svg[data-submenu-chevron],
  [data-desktop-node]:focus-within > a > svg[data-submenu-chevron] {
    transform: rotate(270deg);
  }
</style>

{!hasChildren ? (
  <a
    href={item.href}
    target={item.target || undefined}
    title={item.attrTitle || undefined}
    rel={item.rel || undefined}
    class={`text-navigation text-gw-text-secondary transition-colors duration-200 hover:text-brand-secondary${menuItemClasses(item)}`}
  >
    {item.title}
  </a>
) : (
  <div class="relative" data-desktop-node>
    <a
      href={item.href}
      target={item.target || undefined}
      title={item.attrTitle || undefined}
      rel={item.rel || undefined}
      aria-haspopup="true"
      class={`text-navigation text-gw-text-secondary flex items-center gap-1 transition-colors duration-200 hover:text-brand-secondary${menuItemClasses(item)}`}
    >
      {item.title}
      {isSubmenuMember && (
        <Icon
          name="chevron-right"
          size={4}
          data-submenu-chevron
          class="ml-auto rotate-90 transition-transform duration-200"
        />
      )}
    </a>
    <div
      data-desktop-panel
      class={`invisible absolute top-full z-50 min-w-56 translate-y-1 pt-2 opacity-0 transition-[opacity,transform,visibility] duration-200 ease-out${depth === 0 ? ' left-0' : ' left-full'}`}
    >
      <div class="bg-gw-surface-primary border-gw-border-subtle flex flex-col gap-1 border p-2 shadow-sm">
        <DesktopMenuNodes nodes={item.children} depth={depth + 1} />
      </div>
    </div>
  </div>
)}
