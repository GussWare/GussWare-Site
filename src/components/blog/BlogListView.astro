---
/**
 * Vista del listado del Blog (compartida por `/blog` y `/en/blog`).
 *
 * Recibe el locale y los datos normalizados (`getBlogListing`) y los
 * renderiza con la maquetación existente: hero, filtros/búsqueda por
 * URL, destacada, rejilla, paginación y estados. Todas las URLs
 * internas respetan el locale.
 */
import Container from '../ui/Container.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import Image from '../ui/Image.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { blogBaseUrl, blogListUrl, getBreadcrumbHome } from '../../lib/routes';
import { WP_BLOG_POSTS_PER_PAGE } from '../../lib/wordpress/constants';
import type {
  BlogCard,
  FeaturedPost,
  FeaturedPostImage,
  WpCategory,
} from '../../lib/wordpress/types';

interface Props {
  locale: string;
  initialCards: BlogCard[];
  initialTotalPages: number;
  initialError: boolean;
  initialCategories: WpCategory[] | null;
  currentPage: number;
  currentSearch: string;
  currentCatId: number;
  featuredPost: FeaturedPost | null;
  featuredImage: FeaturedPostImage | null;
}

const {
  locale,
  initialCards,
  initialTotalPages,
  initialError,
  initialCategories,
  currentPage,
  currentSearch,
  currentCatId,
  featuredPost,
  featuredImage,
} = Astro.props;

const homeCrumb = getBreadcrumbHome(locale);
---

<header class="bg-gw-surface-secondary mb-12 py-16 md:py-24">
  <Container>
    <Breadcrumbs items={[homeCrumb, { label: 'Blog' }]} class="mb-4" />
    <h1 class="text-display-lg-mobile md:text-display-lg text-gw-text-primary">
      Blog & Insights
    </h1>
  </Container>
</header>

<div class="bg-gw-surface-auxiliary mb-16">
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div id="blog-filters" class="flex flex-wrap items-center gap-2 md:gap-4">
        <a
          href={blogListUrl(locale, 1, currentSearch, 0)}
          data-cat-id="0"
          aria-pressed={currentCatId === 0 ? 'true' : 'false'}
          class={
            currentCatId === 0
              ? 'text-label-bold bg-supporting-blue-dark text-brand-surface rounded-full px-6 py-2 transition-colors duration-200'
              : 'text-label-bold bg-gw-surface-secondary text-gw-text-secondary border-gw-border-subtle rounded-full border px-6 py-2 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight'
          }
        >
          All
        </a>
        {(initialCategories ?? []).map((category) => (
          <a
            href={blogListUrl(locale, 1, currentSearch, category.id)}
            data-cat-id={category.id}
            aria-pressed={currentCatId === category.id ? 'true' : 'false'}
            class={
              currentCatId === category.id
                ? 'text-label-bold bg-supporting-blue-dark text-brand-surface rounded-full px-6 py-2 transition-colors duration-200'
                : 'text-label-bold bg-gw-surface-secondary text-gw-text-secondary border-gw-border-subtle rounded-full border px-6 py-2 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight'
            }
          >
            {category.name}
          </a>
        ))}
      </div>
      <form
        method="get"
        action={blogBaseUrl(locale)}
        role="search"
        class="relative mt-4 w-full md:mt-0 md:w-72"
      >
        <Icon
          name="search"
          size={4}
          class="text-gw-text-secondary pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
        />
        {currentCatId !== 0 && (
          <input type="hidden" name="category" value={String(currentCatId)} />
        )}
        <input
          id="blog-search"
          name="search"
          type="text"
          placeholder="Search articles..."
          aria-label="Search articles"
          value={currentSearch}
          class="text-body-md text-gw-text-secondary border-gw-border-subtle bg-gw-surface-primary w-full rounded-lg border py-2 pr-4 pl-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark"
        />
      </form>
    </div>
  </Container>
</div>

{/* RGW-185: artículo destacado (maquetación con datos mock de Stitch; sin WordPress todavía). */}
{featuredPost && (
  <div class="mb-30">
    <Container>
      <div class="bg-gw-surface-primary border-gw-border-subtle grid grid-cols-1 items-center gap-8 overflow-hidden rounded-none border md:grid-cols-2">
        <div class="relative h-64 w-full md:h-full md:min-h-96">
          {featuredImage ? (
            <Image
              src={featuredImage.src}
              alt={featuredImage.alt}
              class="absolute inset-0 h-full w-full object-cover"
            />
          ) : (
            <div
              aria-hidden="true"
              class="bg-gw-surface-secondary absolute inset-0 h-full w-full"
            ></div>
          )}
        </div>
        <div class="p-8 md:p-12">
          <div class="mb-4 flex items-center gap-4">
            <Badge>{featuredPost.badge}</Badge>
            {featuredPost.readingTime !== null && (
              <span class="text-body-md text-gw-text-secondary flex items-center gap-1">
                <Icon name="clock" size={4} />
                {featuredPost.readingTime} min read
              </span>
            )}
          </div>
          <h2 class="text-headline-lg text-gw-text-primary mb-4">
            {featuredPost.title}
          </h2>
          <p class="text-body-lg text-gw-text-secondary mb-8">
            {featuredPost.description}
          </p>
          <a
            href={featuredPost.url}
            class="text-label-bold text-supporting-blue-dark hover:text-brand-accent group inline-flex items-center gap-2 transition-colors duration-200"
          >
            Read Article
            <Icon
              name="arrow-right"
              size={4}
              class="transition-transform duration-200 group-hover:translate-x-1"
            />
          </a>
        </div>
      </div>
    </Container>
  </div>
)}

{/* Listado real de WordPress: página 1 en SSR, resto por fetch. */}
<div class="mb-16">
  <Container>
    {!initialError && (
      <div
        id="blog-grid"
        class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
      >
        {initialCards.map((card) => (
          <Card
            imageHeight="h-48"
            badge={card.badge ?? undefined}
            title={card.title}
            href={card.href}
          />
        ))}
        {Array.from({ length: WP_BLOG_POSTS_PER_PAGE }).map(() => (
          <div
            aria-hidden="true"
            class="skeleton-card bg-gw-surface-primary border-gw-border-subtle hidden overflow-hidden rounded-none border"
          >
            <div class="bg-gw-surface-secondary motion-safe:animate-pulse h-48 w-full"></div>
            <div class="flex flex-col p-6">
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-3 h-6 w-24 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-full rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-3/4 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mt-4 h-5 w-28 rounded-none"></div>
            </div>
          </div>
        ))}
      </div>
    )}
    {!initialError && initialTotalPages > 1 && (
      <nav
        id="blog-pagination"
        aria-label="Paginación del blog"
        data-total-pages={String(initialTotalPages)}
        class="mt-12 flex items-center justify-center gap-2"
      >
        {currentPage > 1 ? (
          <a
            href={blogListUrl(
              locale,
              currentPage - 1,
              currentSearch,
              currentCatId,
            )}
            data-page="prev"
            aria-label="Previous page"
            class="text-navigation border-gw-border-subtle text-gw-text-secondary inline-flex h-10 min-w-10 items-center justify-center rounded-none border px-3 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight"
          >
            ‹
          </a>
        ) : (
          <span
            data-page="prev"
            aria-label="Previous page"
            aria-disabled="true"
            class="text-navigation border-gw-border-subtle text-gw-text-secondary inline-flex h-10 min-w-10 items-center justify-center rounded-none border px-3 opacity-50 transition-colors duration-200"
          >
            ‹
          </span>
        )}
        {Array.from({ length: initialTotalPages }).map((_, index) => (
          <a
            href={blogListUrl(locale, index + 1, currentSearch, currentCatId)}
            data-page={index + 1}
            aria-label={`Page ${index + 1}`}
            aria-current={index + 1 === currentPage ? 'page' : undefined}
            class={`text-navigation inline-flex h-10 min-w-10 items-center justify-center rounded-none border px-3 transition-colors duration-200 ${
              index + 1 === currentPage
                ? 'bg-supporting-blue-dark text-brand-surface border-transparent'
                : 'border-gw-border-subtle text-gw-text-secondary hover:border-gw-highlight hover:bg-gw-highlight'
            }`}
          >
            {index + 1}
          </a>
        ))}
        {currentPage < initialTotalPages ? (
          <a
            href={blogListUrl(
              locale,
              currentPage + 1,
              currentSearch,
              currentCatId,
            )}
            data-page="next"
            aria-label="Next page"
            class="text-navigation border-gw-border-subtle text-gw-text-secondary inline-flex h-10 min-w-10 items-center justify-center rounded-none border px-3 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight"
          >
            ›
          </a>
        ) : (
          <span
            data-page="next"
            aria-label="Next page"
            aria-disabled="true"
            class="text-navigation border-gw-border-subtle text-gw-text-secondary inline-flex h-10 min-w-10 items-center justify-center rounded-none border px-3 opacity-50 transition-colors duration-200"
          >
            ›
          </span>
        )}
      </nav>
    )}
    <div id="blog-empty" class="hidden py-8 text-center">
      <SectionHeading
        title="No articles found"
        description="Try adjusting your search or filter."
        align="center"
      />
    </div>
    <div
      id="blog-error"
      class={`py-8 text-center${initialError ? '' : ' hidden'}`}
      role="alert"
    >
      <SectionHeading
        title="Something went wrong"
        description="Please try again later."
        align="center"
      />
    </div>
  </Container>
</div>
