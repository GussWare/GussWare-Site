---
/**
 * Sección de artículos relacionados / otros artículos del detalle del Blog.
 *
 * Una sola petición (`fetchPostPage`, 15 resultados): prioriza misma
 * categoría y luego mismos tags, excluye el actual, máximo 15. Sin
 * relacionados muestra otros publicados ("Otros artículos"); sin ninguno
 * no renderiza nada. `hasMore` sale de `totalPages` (más de 15 en total).
 * Carrusel manual con Embla (sin autoplay): 3/2/1 visibles por breakpoint,
 * prev/next, dots e indicador. Cards con `Card.astro`.
 */
import Card from '../ui/Card.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { fetchPostPage, normalizeBlogCard } from '../../lib/wordpress/post';
import { blogBaseUrl } from '../../lib/routes';
import type { BlogCard } from '../../lib/wordpress/types';

interface Props {
  currentId: number;
  categories: number[];
  tags: number[];
  baseUrl: string;
  catMap: Record<number, string>;
  lang: string;
}

const { currentId, categories, tags, baseUrl, catMap, lang } = Astro.props;

let slides: BlogCard[] = [];
let sectionTitle = 'Related Reading';
let hasMore = false;

try {
  const { items, totalPages } = await fetchPostPage({
    baseUrl,
    page: 1,
    perPage: 15,
    query: '',
    catId: 0,
    lang,
  });
  hasMore = totalPages > 1;

  const seen = new Set<number>([currentId]);
  const related: BlogCard[] = [];
  const others: BlogCard[] = [];

  for (const item of items) {
    if (item.id === currentId || seen.has(item.id)) {
      continue;
    }

    seen.add(item.id);
    const card = normalizeBlogCard(item, catMap, lang);
    const isRelated =
      item.categories?.some((category) => categories.includes(category)) ||
      item.tags?.some((tag) => tags.includes(tag));

    if (isRelated) {
      related.push(card);
    } else {
      others.push(card);
    }

    if (related.length + others.length >= 15) {
      break;
    }
  }

  if (related.length > 0) {
    slides = related.slice(0, 15);
  } else if (others.length > 0) {
    slides = others.slice(0, 15);
    sectionTitle = 'Otros artículos';
  }
} catch {
  // Sin datos: la sección no se renderiza.
}
---

{slides.length > 0 && (
  <section aria-label={sectionTitle} class="mt-16 md:mt-24">
    <div class="mb-8 flex items-end justify-between gap-4">
      <SectionHeading title={sectionTitle} />
      <a
        href={blogBaseUrl(lang)}
        class="text-label-bold text-supporting-blue-dark hover:text-brand-accent hidden items-center gap-2 transition-colors duration-200 md:inline-flex"
      >
        View All
        <Icon name="arrow-right" size={4} />
      </a>
    </div>
    <div class="overflow-hidden" data-related-viewport>
      <div class="-ml-6 flex md:-ml-8" data-related-track>
        {slides.map((card) => (
          <div class="min-w-0 shrink-0 grow-0 basis-full pl-6 md:basis-1/2 md:pl-8 lg:basis-1/3">
            <div class="h-full">
              <Card
                imageHeight="h-48"
                badge={card.badge ?? undefined}
                title={card.title}
                href={card.href}
              />
            </div>
          </div>
        ))}
        {hasMore && (
          <div class="min-w-0 shrink-0 grow-0 basis-full pl-6 md:basis-1/2 md:pl-8 lg:basis-1/3">
            <a
              href={blogBaseUrl(lang)}
              class="border-gw-border-subtle text-label-bold text-supporting-blue-dark hover:text-brand-accent flex h-full min-h-48 flex-col items-center justify-center gap-2 rounded-none border transition-colors duration-200"
            >
              Ver todos
              <Icon name="arrow-right" size={4} />
            </a>
          </div>
        )}
      </div>
    </div>
    <div class="mt-8 flex items-center justify-center gap-4">
      <button
        type="button"
        aria-label="Previous related articles"
        data-related-prev
        class="text-navigation border-gw-border-subtle text-gw-text-secondary inline-flex h-10 min-w-10 items-center justify-center rounded-none border px-3 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight disabled:opacity-50"
      >
        ‹
      </button>
      <div
        class="flex items-center gap-2"
        data-related-dots
        aria-label="Related articles pages"
      ></div>
      <span
        data-related-status
        aria-live="polite"
        class="text-body-md text-gw-text-secondary"
      ></span>
      <button
        type="button"
        aria-label="Next related articles"
        data-related-next
        class="text-navigation border-gw-border-subtle text-gw-text-secondary inline-flex h-10 min-w-10 items-center justify-center rounded-none border px-3 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight disabled:opacity-50"
      >
        ›
      </button>
    </div>
    <div class="mt-8 md:hidden">
      <Button href={blogBaseUrl(lang)} variant="secondary" class="w-full">
        View All Articles
      </Button>
    </div>
  </section>
)}

<script>
  import EmblaCarousel from 'embla-carousel';

  const viewport = document.querySelector('[data-related-viewport]');
  const prevButton = document.querySelector('[data-related-prev]');
  const nextButton = document.querySelector('[data-related-next]');
  const dotsWrap = document.querySelector('[data-related-dots]');
  const status = document.querySelector('[data-related-status]');

  if (viewport instanceof HTMLElement) {
    const embla = EmblaCarousel(viewport, {
      loop: false,
      align: 'start',
      containScroll: 'trimSnaps',
      slidesToScroll: 1,
      breakpoints: {
        '(min-width: 768px)': { slidesToScroll: 2 },
        '(min-width: 1024px)': { slidesToScroll: 3 },
      },
    });

    const dots: HTMLButtonElement[] = [];

    const update = () => {
      const snaps = embla.scrollSnapList();
      const selected = embla.selectedScrollSnap();

      dots.forEach((dot, index) => {
        const isSelected = index === selected;
        dot.classList.toggle('bg-brand-secondary', isSelected);
        dot.classList.toggle('bg-gw-border-subtle', !isSelected);
        dot.setAttribute('aria-current', isSelected ? 'true' : 'false');
      });

      if (status instanceof HTMLElement) {
        status.textContent = `${selected + 1} / ${snaps.length}`;
      }

      if (prevButton instanceof HTMLButtonElement) {
        prevButton.disabled = !embla.canScrollPrev();
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = !embla.canScrollNext();
      }
    };

    const buildDots = () => {
      if (!(dotsWrap instanceof HTMLElement)) {
        return;
      }

      dotsWrap.innerHTML = '';
      dots.length = 0;
      embla.scrollSnapList().forEach((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', `Go to page ${index + 1}`);
        dot.className =
          'bg-gw-border-subtle h-2 w-2 rounded-none transition-colors duration-200';
        dot.addEventListener('click', () => {
          embla.scrollTo(index);
        });
        dotsWrap.appendChild(dot);
        dots.push(dot);
      });
    };

    prevButton?.addEventListener('click', () => {
      embla.scrollPrev();
    });

    nextButton?.addEventListener('click', () => {
      embla.scrollNext();
    });

    embla.on('select', update);
    embla.on('reInit', () => {
      buildDots();
      update();
    });
    buildDots();
    update();
  }
</script>
