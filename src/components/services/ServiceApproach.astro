---
/**
 * Cómo trabajamos (Stitch `Servicio Detalle`, S04).
 *
 * Encabezado a ancho de lectura (`max-w-3xl`) y retícula de tarjetas
 * con el número de fase en un cuadro mono, título y descripción. La
 * retícula se deriva de la cantidad de pasos que entrega WordPress
 * (1..N): una tarjeta se centra a ancho de lectura, dos y tres usan
 * columnas equivalentes, cuatro usa 4 columnas en desktop y cinco o
 * más reparte en 3.
 *
 * Todo el contenido es dinámico (`approach_eyebrow`, `approach_title`,
 * `approach_description`, `approach[]`); la numeración (`01`) deriva
 * del índice. Sin interacción: la referencia es estática.
 */
import Section from '../ui/Section.astro';
import { formatSectionEyebrow } from '../../lib/services/section-number';

interface ApproachItem {
  title: string;
  description: string;
}

interface Props {
  id?: string;
  /** Número de sección calculado por la plantilla (`01`, `02`…). */
  number?: string;
  eyebrow?: string;
  title: string;
  description: string;
  items: ApproachItem[];
}

const {
  id = undefined,
  number = undefined,
  eyebrow = undefined,
  title,
  description,
  items,
} = Astro.props;

const displayEyebrow = formatSectionEyebrow(number, eyebrow);

const pad = (n: number): string => String(n).padStart(2, '0');

const gridCols =
  items.length === 1
    ? 'max-w-3xl'
    : items.length === 2
      ? 'md:grid-cols-2'
      : items.length === 3
        ? 'sm:grid-cols-2 lg:grid-cols-3'
        : items.length === 4
          ? 'md:grid-cols-2 lg:grid-cols-4'
          : 'md:grid-cols-2 lg:grid-cols-3';
---

{items.length > 0 && (
  <Section
    id={id}
    class="bg-gw-surface-secondary border-b border-gw-border-subtle"
  >
    <div class="max-w-3xl mb-12">
      {displayEyebrow && (
        <p class="text-label-bold uppercase text-brand-primary mb-3">
          {displayEyebrow}
        </p>
      )}
      {title && (
        <h2 class="text-gw-text-primary text-headline-lg font-bold leading-tight mb-5">
          {title}
        </h2>
      )}
      {description && (
        <p class="text-gw-text-secondary text-body-md leading-relaxed">
          {description}
        </p>
      )}
    </div>
    <div class:list={['grid grid-cols-1 gap-8 items-stretch', gridCols]}>
      {items.map((item, index) => (
        <div class="bg-gw-surface-primary border border-gw-border-subtle p-6 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 border-2 border-brand-primary text-brand-primary font-mono font-bold text-headline-md flex items-center justify-center mb-6 bg-gw-surface-primary">
              {pad(index + 1)}
            </div>
            <h3 class="text-gw-text-primary text-headline-md font-bold mb-3">
              {item.title}
            </h3>
            <p class="text-gw-text-secondary text-body-md leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </Section>
)}
