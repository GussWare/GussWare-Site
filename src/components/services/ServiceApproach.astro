---
/**
 * RGW-EP09-06-04 — Acordeón "Nuestro Enfoque" del detalle de servicio.
 *
 * Contenido 100% dinámico (`approach[]` de WordPress, numeración por
 * índice); comportamiento en Astro reutilizando el patrón de
 * `home/Faq.astro` (`aria-expanded`, `hidden`, `+/−`, sin dependencias).
 */
import Section from '../ui/Section.astro';

interface ApproachItem {
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  items: ApproachItem[];
}

const { title, description, items } = Astro.props;

const pad = (n: number): string => String(n).padStart(2, '0');
---

{items.length > 0 && (
  <Section>
    <div data-approach class="grid grid-cols-1 items-start gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        {title && (
          <h2 class="text-gw-text-primary text-headline-lg mb-6">{title}</h2>
        )}
        {description && (
          <p class="text-gw-text-secondary text-body-lg">{description}</p>
        )}
      </div>
      <div data-approach-list class="space-y-4 md:col-span-8">
        {items.map((item, index) => (
          <div
            data-approach-item
            class="border-gw-border-subtle border-b"
          >
            <button
              type="button"
              data-approach-button
              id={`approach-button-${index}`}
              aria-expanded="false"
              aria-controls={`approach-panel-${index}`}
              class="group flex w-full items-center justify-between py-6 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark"
            >
              <span class="flex items-center gap-6">
                <span class="text-gw-text-muted text-headline-md opacity-50">
                  {pad(index + 1)}
                </span>
                <span class="text-gw-text-primary text-headline-md transition-colors duration-200 group-hover:text-supporting-blue-dark">
                  {item.title}
                </span>
              </span>
              <span
                data-approach-icon
                aria-hidden="true"
                class="text-supporting-blue-dark text-body-lg font-bold"
              >
                +
              </span>
            </button>
            <div
              data-approach-panel
              id={`approach-panel-${index}`}
              role="region"
              aria-labelledby={`approach-button-${index}`}
              hidden
              class="hidden"
            >
              <div class="pr-4 pb-8 pl-16">
                <p class="text-gw-text-secondary text-body-md">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Section>
)}

<script>
  const root = document.querySelector('[data-approach]');

  if (root instanceof HTMLElement) {
    root.querySelectorAll('[data-approach-button]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      const panelId = button.getAttribute('aria-controls');
      const panel = panelId ? root.querySelector(`#${panelId}`) : null;

      button.addEventListener('click', () => {
        const next =
          button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(next));

        if (panel instanceof HTMLElement) {
          panel.hidden = !next;
          panel.classList.toggle('hidden', !next);
        }

        const icon = button.querySelector('[data-approach-icon]');
        if (icon instanceof HTMLElement) {
          icon.textContent = next ? '−' : '+';
        }
      });
    });
  }
</script>
