---
/**
 * RGW-EP09-06 — Template único del detalle de servicios.
 *
 * Renderiza exclusivamente desde el CPT `service` (prop `service`);
 * sin literales de contenido ni lógica por slug. Las secciones crecen
 * por tarjeta (intro → desarrollo → soluciones → enfoque → tech/CTA).
 */
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Image from '../ui/Image.astro';
import Button from '../ui/Button.astro';
import ServiceApproach from './ServiceApproach.astro';
import Faq from '../home/Faq.astro';
import FinalCta from '../home/FinalCta.astro';
import { getBreadcrumbHome } from '../../lib/routes';
import { stripHtml } from '../../lib/wordpress/text';
import type { WpService } from '../../lib/wordpress/types';

interface Props {
  service: WpService;
  image: { src: string; alt: string } | null;
  locale: string;
  indexUrl: string;
  indexLabel: string;
}

const { service, image, locale, indexUrl, indexLabel } = Astro.props;

const home = getBreadcrumbHome(locale);
const acf = service.acf;
const title = stripHtml(service.title.rendered);
---

<Section>
  <Breadcrumbs
    items={[
      { label: home.label, href: home.href },
      { label: indexLabel, href: indexUrl },
      { label: title },
    ]}
    class="mb-8"
  />
  <SectionHeading
    eyebrow={acf.intro_eyebrow}
    title={acf.intro_title}
    level={1}
    description={acf.intro_description}
  />
  {image && (
    <div class="relative z-10 mt-8 overflow-hidden rounded-xl shadow-lg">
      <Image
        src={image.src}
        alt={image.alt}
        fit="contain"
        loading="eager"
        class="h-auto w-full"
      />
    </div>
  )}
</Section>

{/* RGW-EP09-06-02 — Desarrollo editorial desde WordPress. */}
{acf.development_title && (
  <Section>
    <div class="max-w-3xl">
      <h2 class="text-gw-text-primary text-display-lg-mobile md:text-display-lg mb-6">
        {acf.development_title}
      </h2>
      {acf.development_content && (
        <p class="text-gw-text-secondary text-body-lg">
          {acf.development_content}
        </p>
      )}
    </div>
  </Section>
)}

{/* RGW-EP09-06-03 — Soluciones dinámicas (`solutions[]`, N elementos). */}
{(acf.solutions ?? []).length > 0 && (
  <Section>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6 mb-12 items-start">
      <div class="md:col-span-5">
        <h2 class="text-gw-text-primary text-display-lg-mobile md:text-display-lg">
          {acf.solutions_title}
        </h2>
      </div>
      <div class="md:col-span-6 md:col-start-7 pt-2 md:pt-4">
        <p class="text-gw-text-secondary text-body-lg max-w-lg">
          {acf.solutions_description}
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {(acf.solutions ?? []).map((solution) => (
        <article class="bg-gw-surface-primary border-gw-border-subtle rounded-none border p-8 transition-colors duration-200 hover:bg-gw-surface-secondary md:p-10">
          <h3 class="text-gw-text-primary text-headline-md mb-4">
            {solution.title}
          </h3>
          <p class="text-gw-text-secondary text-body-md mb-6">
            {solution.description}
          </p>
          {(solution.features ?? []).length > 0 && (
            <ul class="mb-6 flex flex-col gap-2">
              {(solution.features ?? []).map((feature) => (
                <li class="text-gw-text-secondary text-body-md flex items-center gap-2">
                  <span
                    aria-hidden="true"
                    class="bg-brand-accent inline-block h-1.5 w-1.5"
                  ></span>
                  {feature.feature}
                </li>
              ))}
            </ul>
          )}
          {solution.link?.text && (
            <Button
              variant="secondary"
              href={solution.link.url || undefined}
            >
              {solution.link.text}
            </Button>
          )}
        </article>
      ))}
    </div>
  </Section>
)}

{/* RGW-EP09-06-04 — Nuestro Enfoque: acordeón dinámico. */}
<ServiceApproach
  title={acf.approach_title}
  description={acf.approach_description}
  items={acf.approach ?? []}
/>

{/* RGW-EP09-06-05 — Tecnologías dinámicas (sin hardcodear). */}
{(acf.tech_groups ?? []).length > 0 && (
  <Section>
    <div class="max-w-3xl mb-12">
      <h2 class="text-gw-text-primary text-display-lg-mobile md:text-display-lg mb-6">
        {acf.tech_title}
      </h2>
      {acf.tech_description && (
        <p class="text-gw-text-secondary text-body-lg">
          {acf.tech_description}
        </p>
      )}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {(acf.tech_groups ?? []).map((group) => (
        <div class="bg-gw-surface-secondary rounded-none p-8">
          <h3 class="text-gw-text-primary text-headline-md mb-4">
            {group.title}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {(group.items ?? []).map((tech) => (
              <li class="bg-gw-surface-primary border-gw-border-subtle text-gw-text-secondary text-body-md rounded-none border px-3 py-1">
                {tech.name}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>
)}

{/* RGW-EP09-06-05 — FAQ opcional reutilizando `Faq` del Home. */}
{(acf.faq_items ?? []).length > 0 && (
  <Faq
    faq={{
      eyebrow: '',
      titulo: '',
      descripcion: '',
      preguntas: acf.faq_items,
    }}
  />
)}

{/* RGW-EP09-06-05 — CTA reutilizando `FinalCta` del Home. */}
<FinalCta
  finalCta={{
    title: acf.cta.title,
    description: acf.cta.description,
    button_text: acf.cta.button_text,
    button_url: acf.cta.button_url,
  }}
/>
