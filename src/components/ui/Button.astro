---
/**
 * RGW-104 — Button global reutilizable.
 *
 * Variantes de Stitch con tokens existentes:
 * - primary → `bg-gw-action-primary` + `text-brand-surface` (idéntico al CTA
 *   del Header, incluido `hover:opacity-90`);
 * - secondary → borde 2px `border-gw-text-primary`, hover con fondo ink y
 *   texto `text-brand-surface`;
 * - ghost → texto `text-brand-secondary` con subrayado en hover.
 * - outline-light (RGW-312) → acción secundaria sobre fondos oscuros:
 *   borde 2px `border-brand-surface` + `text-brand-surface`, hover con
 *   fondo superficie y texto `text-brand-primary` (el sistema no tenía
 *   secundaria legible sobre `brand-primary`; p. ej. CTA oscuro del
 *   listado de Proyectos, Stitch `Proyectos - Listado`).
 * Tipografía `text-label-bold`, `rounded-none`, spacing `px-6 py-3`.
 * Focus visible con anillo `supporting-blue-dark` (estado de Stitch).
 *
 * Diferencias documentadas (regla 10, sin inventar valores):
 * - el hover primario oscuro de Stitch no existe como token → se reutiliza
 *   `hover:opacity-90`, patrón ya usado en el proyecto;
 * - padding Stitch (12/24 y 10/22) → ritmo `px-6 py-3` del proyecto.
 *
 * Semántica: renderiza `<a>` si recibe `href`, `<button>` en otro caso.
 * La base solo aporta `display: inline-flex` cuando `class` no define su
 * propio `display`: en la cascada de Tailwind `.inline-flex` se emite
 * después de `.hidden` (misma especificidad), por lo que un `inline-flex`
 * interno dejaría sin efecto un `hidden` externo responsive.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline-light';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  variant = 'primary',
  href = undefined,
  type = 'button',
  class: className = '',
} = Astro.props;

const EXTERNAL_DISPLAY_PATTERN =
  /\b(hidden|block|inline|inline-block|flex|inline-flex|grid|inline-grid|contents|table)\b/;

const baseDisplay = EXTERNAL_DISPLAY_PATTERN.test(className)
  ? ''
  : 'inline-flex';

const base = `${baseDisplay} items-center justify-center rounded-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark`;

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary:
    'text-label-bold bg-gw-action-primary text-brand-surface px-6 py-3 transition-opacity hover:opacity-90',
  secondary:
    'text-label-bold border-gw-text-primary text-gw-text-primary px-6 py-3 border-2 transition-colors duration-200 hover:bg-gw-text-primary hover:text-brand-surface',
  ghost:
    'text-navigation text-brand-secondary transition-colors duration-200 hover:underline',
  'outline-light':
    'text-label-bold border-brand-surface text-brand-surface hover:bg-brand-surface hover:text-brand-primary px-6 py-3 border-2 transition-colors duration-200',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
