---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={weight === 'emphasis' ? 2 : 1.5}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`${sizes[size]} ${className}`}
  aria-hidden="true"
>
  <Fragment set:html={paths[name]} />
</svg>
