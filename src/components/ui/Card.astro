---
/**
 * RGW-113 — Card global reutilizable (tarjeta editorial de Stitch).
 *
 * Estructura de Stitch con tokens existentes: contenedor
 * `bg-gw-surface-primary` + borde `border-gw-border-subtle` + `rounded-none`,
 * imagen (`4/3` o altura fija), cuerpo `p-6`, Badge en flujo sobre el
 * título (`mb-3`), título `text-headline-md`, descripción `text-body-md`,
 * metadatos `text-body-md text-gw-text-muted`.
 * Hover con tokens (`group-hover:text-supporting-blue-dark`) y escala de
 * imagen de Stitch; sin sombras (el sistema usa capas tonales, no sombras).
 *
 * Diferencia documentada: Stitch fija el título a 20px con un override sin
 * token equivalente; se usa `headline-md` para conservar la jerarquía.
 *
 * RGW-188 — Adaptación para tarjetas de artículos del Blog (Stitch
 * `GussWare Blog-V0.1.0`), compatible hacia atrás (todo opcional):
 * - `href` + `linkLabel` (defecto `Read more`): fila de enlace
 *   `label-bold` color `supporting-blue-dark`, hover `brand-accent`, con
 *   icono `arrow-right`;
 * - `image` opcional: sin imagen se muestra un bloque `h-48`
 *   `bg-gw-surface-secondary` (maquetación/mock, sin assets);
 * - `imageHeight` (p. ej. `h-48`): altura fija de Stitch para el grid
 *   en lugar de la proporción `4/3` por defecto;
 * - con `href`, el cuerpo llena la tarjeta (`flex-grow`, como en Stitch)
 *   y el título crece para alinear los enlaces abajo.
 *
 * RGW-303 — Modo `skeleton` para estados de carga (hallazgo #20 del
 * tree RGW-288: el skeleton del blog replicaba la geometría de Card a
 * mano): con `skeleton`, se renderiza la misma carcasa (`article`,
 * bloque de imagen y cuerpo `p-6`) con barras `animate-pulse`
 * `aria-hidden`, sin contenido. `title` es opcional para este modo.
 */
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import Image from './Image.astro';

interface Props {
  image?: { src: string; alt: string };
  imageHeight?: string;
  badge?: string;
  title?: string;
  description?: string;
  date?: string;
  readingTime?: string;
  href?: string;
  linkLabel?: string;
  /** Estado de carga: carcasa con barras `animate-pulse`, sin contenido. */
  skeleton?: boolean;
  class?: string;
}

const {
  image = undefined,
  imageHeight = undefined,
  badge = undefined,
  title = '',
  description = undefined,
  date = undefined,
  readingTime = undefined,
  href = undefined,
  linkLabel = 'Read more',
  skeleton = false,
  class: className = '',
} = Astro.props;
---

{skeleton ? (
  <article
    aria-hidden="true"
    class={`bg-gw-surface-primary border-gw-border-subtle flex h-full flex-col overflow-hidden rounded-none border ${className}`}
  >
    <div class={`bg-gw-surface-secondary motion-safe:animate-pulse w-full overflow-hidden rounded-none ${imageHeight ?? 'aspect-[4/3]'}`} />
    <div class="flex flex-grow flex-col p-6">
      <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-3 h-6 w-24 rounded-none" />
      <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-full rounded-none" />
      <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-3/4 rounded-none" />
      <div class="bg-gw-surface-secondary motion-safe:animate-pulse mt-4 h-5 w-28 rounded-none" />
    </div>
  </article>
) : (
<article
  class={`bg-gw-surface-primary border-gw-border-subtle group flex h-full flex-col overflow-hidden rounded-none border ${className}`}
>
  <div class="relative">
    {image ? (
      imageHeight ? (
        <div class={`w-full overflow-hidden rounded-none ${imageHeight}`}>
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      ) : (
        <Image
          src={image.src}
          alt={image.alt}
          ratio="4/3"
          class="transition-transform duration-500 group-hover:scale-105"
        />
      )
    ) : (
      <div
        aria-hidden="true"
        class={`bg-gw-surface-secondary w-full overflow-hidden rounded-none ${imageHeight ?? 'aspect-[4/3]'}`}
      />
    )}
  </div>
  <div class="flex flex-grow flex-col p-6">
    {badge && (
      <div class="mb-3">
        <Badge class="font-normal">{badge}</Badge>
      </div>
    )}
    <h3
      class={`text-gw-text-primary text-headline-md group-hover:text-supporting-blue-dark mb-4 transition-colors duration-200 ${href ? 'flex-grow' : ''}`}
    >
      {title}
    </h3>
    {description && (
      <p class="text-gw-text-secondary text-body-md mb-6">{description}</p>
    )}
    {(date || readingTime) && (
      <p class="text-gw-text-muted text-body-md mt-auto flex justify-between gap-4">
        <span>{date}</span>
        <span>{readingTime}</span>
      </p>
    )}
    {href && (
      <a
        href={href}
        class="text-label-bold text-supporting-blue-dark hover:text-brand-accent mt-4 inline-flex items-center gap-2 transition-colors duration-200"
      >
        {linkLabel}
        <Icon name="arrow-right" size={4} />
      </a>
    )}
  </div>
</article>
)}
