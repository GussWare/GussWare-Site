---
/**
 * Botón hamburguesa reutilizable (control visual del menú mobile).
 *
 * Encapsula el botón del Header con sus mismos valores y tokens
 * existentes (`text-gw-text-secondary`, `p-2`): `<button type="button">`
 * con `id`, `aria-expanded`, `aria-controls`, `aria-label` e icono
 * hamburguesa decorativo (`aria-hidden="true"`).
 *
 * No implementa la lógica de apertura/cierre; el Header sigue siendo
 * responsable del `click` sobre `#header-mobile-menu`.
 *
 * Nota: `Icon.astro` no contempla el icono hamburguesa (solo
 * `arrow-right` y `arrow-outward`), por lo que el trazado se mantiene
 * inline idéntico al actual, sin modificar `Icon.astro`.
 */
interface Props {
  id: string;
  expanded?: boolean;
  controls: string;
  label: string;
  class?: string;
}

const {
  id,
  expanded = false,
  controls,
  label,
  class: className = '',
} = Astro.props;
---

<button
  type="button"
  id={id}
  aria-expanded={expanded}
  aria-controls={controls}
  aria-label={label}
  class={className}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line x1="4" x2="20" y1="6" y2="6"></line>
    <line x1="4" x2="20" y1="12" y2="12"></line>
    <line x1="4" x2="20" y1="18" y2="18"></line>
  </svg>
</button>
