---
/**
 * Selector de idioma — Maquetación según Stitch `GussWare Home-V0.1.0`
 * (grupo ES | EN del Header, variantes `header` y `panel` móvil).
 *
 * Navega a la URL equivalente en el idioma elegido: usa `localeUrls`
 * (resueltas por la página vía traducciones de WordPress/Polylang)
 * cuando se proporcionan, o la ruta equivalente genérica en su defecto.
 * El idioma activo se obtiene de `Astro.currentLocale`.
 * Reutiliza tokens existentes: `supporting-blue-dark`, `brand-surface`,
 * `gw-surface-primary/secondary`, `gw-text-primary`, `gw-border-subtle`.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { LocaleUrls } from '../../lib/routes';

interface Props {
  /** Idioma marcado visualmente como activo. */
  current?: 'es' | 'en';
  /** URLs equivalentes por locale (traducciones resueltas por la página). */
  localeUrls?: LocaleUrls;
  /**
   * `header`: grupo compacto en línea (cluster del Header).
   * `panel`: bloque de ancho completo con etiqueta (panel móvil).
   */
  variant?: 'header' | 'panel';
  class?: string;
}

const {
  current = Astro.currentLocale === 'en' ? 'en' : 'es',
  localeUrls = undefined,
  variant = 'header',
  class: className = '',
} = Astro.props;

// Ruta equivalente genérica: mismo path con/sin el prefijo `/en/`.
const barePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const fallbackUrls: LocaleUrls = {
  es: getRelativeLocaleUrl('es', barePath === '/' ? '/' : barePath.slice(1)),
  en: getRelativeLocaleUrl('en', barePath === '/' ? '/' : barePath.slice(1)),
};

const hrefs: LocaleUrls = localeUrls ?? fallbackUrls;

const languages = [
  { code: 'es', label: 'ES' },
  { code: 'en', label: 'EN' },
] as const;

const linkBase =
  'inline-flex items-center justify-center text-xs font-bold uppercase tracking-wider focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark';
const linkActive = 'bg-supporting-blue-dark text-brand-surface';
const desktopInactive =
  'bg-transparent text-gw-text-primary hover:bg-gw-surface-secondary hover:text-supporting-blue-dark hover:underline';
const panelInactive =
  'bg-transparent text-gw-text-primary hover:bg-gw-surface-secondary';
---

{variant === 'header' ? (
  <div
    role="group"
    aria-label="Language selector"
    class={`inline-flex overflow-hidden rounded-none border border-gw-border-subtle bg-gw-surface-primary ${className}`}
  >
    {languages.map((language) => (
      <a
        href={hrefs[language.code]}
        aria-pressed={current === language.code ? 'true' : 'false'}
        class={`${linkBase} min-h-[38px] px-3 py-1.5 ${current === language.code ? linkActive : desktopInactive}`}
      >
        {language.label}
      </a>
    ))}
  </div>
) : (
  <div class={`border-t border-gw-border-subtle/40 pt-4 ${className}`}>
    <span class="text-gw-text-primary/70 mb-2 block text-xs font-bold uppercase tracking-wider">
      IDIOMA / LANGUAGE
    </span>
    <div
      role="group"
      aria-label="Language selector mobile"
      class="flex overflow-hidden rounded-none border border-gw-border-subtle bg-gw-surface-primary"
    >
      {languages.map((language) => (
        <a
          href={hrefs[language.code]}
          aria-pressed={current === language.code ? 'true' : 'false'}
          class={`${linkBase} min-h-[44px] flex-1 py-2 ${current === language.code ? linkActive : panelInactive}`}
        >
          {language.label}
        </a>
      ))}
    </div>
  </div>
)}
