---
/**
 * Vista del listado de Proyectos (RGW-312, compartida por `/proyectos`
 * y `/en/proyectos`).
 *
 * Referencia visual 1:1: pantalla Stitch `Proyectos - Listado`
 * (`GussWare - Nuestros Proyectos (Portafolio Oficial)`); `gussware-layout`
 * define cómo implementarla dentro del sistema existente.
 *
 * Composición solo con componentes existentes (§1, §2): `Layout` en la
 * página fina, `Section` por bloque (§3), `Container` en la banda de
 * filtros, `Breadcrumbs` como hermano sobre el encabezado, `Badge`
 * (calibrado con `class` aditiva) para distintivo y métrica,
 * `ProjectCard` (dominio, compone `Badge` + `Image` + `Icon`) para cada
 * proyecto, `CTA` (`tone="dark"`, acción secundaria `outline-light`)
 * para el cierre e `Icon` (`search`, catálogo cerrado) en el buscador.
 * `ProjectCard` es componente de dominio (§7, catalogado en
 * `reference.md`): la `Card` global no cubre esa anatomía. Spacing con
 * tokens y patrones del sistema (§4); mobile-first con breakpoint `md`
 * estándar, `flex-wrap` anti-overflow (§5);
 * `display`/`headline-md`/`body-lg`/`label-bold` y un solo `h1` (§6).
 *
 * Contenido estático verbatim de Stitch (ES) como referencia visual,
 * pendiente del CPT Proyectos del épico RGW-325: la prop `projects`
 * deja la vista preparada para recibir datos de WordPress/i18n sin
 * cambiar la estructura. Sin `image` la tarjeta renderiza su bloque
 * neutro de maquetación (sin assets ni URLs inventadas). Los `href`
 * usan `projectDetailUrl` (ruta del épico RGW-325).
 *
 * Filtros y paginación quedan maquetados como representación visual
 * estática, sin funcionalidad ni lógica de consulta (SPEC): controles
 * nativos (`input`, `select`, `button`) listos para la integración.
 * Textos de taxonomías (pills, opciones de tecnología) verbatim ES en
 * ambos locales hasta que WordPress los localice; el resto del chrome
 * sí se traduce.
 *
 * Diferencias documentadas frente a Stitch (sin equivalente en el
 * sistema):
 * - tarjetas sin foto (bloque neutro `4/3` del sistema; Stitch `16/10`
 *   con foto mock externa; SPEC: no inventar assets) y título
 *   `headline-md` del sistema (jerarquía de tarjetas; Stitch ~20-24px
 *   sin token equivalente).
 * - CTA secundario (`/how-we-work`, verbatim Stitch) con la nueva
 *   variante `outline-light` de `Button`; esa ruta aún no existe en el
 *   proyecto (precedente RGW-311: `linkHref='/projects'`).
 */
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Badge from '../ui/Badge.astro';
import ProjectCard from './ProjectCard.astro';
import CTA from '../ui/CTA.astro';
import Icon from '../ui/Icon.astro';
import { projectDetailUrl, getBreadcrumbHome } from '../../lib/routes';

/** Ítem del listado (futura: resuelto desde el CPT Proyectos). */
interface ProjectListItem {
  slug: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  code: string;
}

interface Props {
  locale: string;
  projects?: ProjectListItem[];
}

/**
 * Contenido de referencia verbatim de Stitch (`Proyectos - Listado`,
 * 6 tarjetas). Provisional hasta el CPT Proyectos (RGW-325); los
 * `slug` son los de Stitch sobre la base `/proyectos` del épico.
 */
const DEFAULT_PROJECTS: ProjectListItem[] = [
  {
    slug: 'sistema-nominas',
    title: 'Sistema de Nóminas Tradicionales y Estrategia en la Nube',
    description:
      'Plataforma integral para gestión de nóminas gravadas al 100% y con estrategia para empresas de outsourcing con 7 módulos clave y reportes consolidados.',
    category: 'Sistemas Empresariales',
    tags: ['PHP', 'CodeIgniter', 'MySQL', 'Apache', 'JS'],
    code: '#ERP-2024',
  },
  {
    slug: 'fintech-connect',
    title: 'FinTech Connect — App Móvil de Pagos Transfronterizos',
    description:
      'Aplicación móvil multiplataforma de alta seguridad con autenticación biométrica, procesamiento de remesas instantáneas y conexión con redes bancarias.',
    category: 'Aplicaciones Móviles',
    tags: ['Flutter', 'Dart', 'Node.js', 'AWS', 'PostgreSQL'],
    code: '#MOB-781',
  },
  {
    slug: 'apex-commerce',
    title: 'Apex Commerce — Portal Headless y Catálogo B2B',
    description:
      'Arquitectura de comercio digital de alto rendimiento con renderizado estático, sincronización de inventarios multitienda y checkout optimizado.',
    category: 'Desarrollo Web',
    tags: ['Next.js', 'TypeScript', 'GraphQL', 'Stripe'],
    code: '#WEB-302',
  },
  {
    slug: 'gateway-fiscal',
    title: 'Gateway Unificado de Facturación y Servicios Fiscales',
    description:
      'Infraestructura de microservicios para timbrado masivo, conciliación tributaria y orquestación con proveedores de certificación autorizados.',
    category: 'APIs & Backend',
    tags: ['Python', 'FastAPI', 'Docker', 'Redis', 'RabbitMQ'],
    code: '#API-909',
  },
  {
    slug: 'cloud-infra',
    title: 'Infraestructura Automatizada Multi-Región y CI/CD',
    description:
      'Migración a contenedores orquestados con despliegue automatizado, tolerancia a fallos y reducción del 40% en costos de operación en la nube.',
    category: 'DevOps & Cloud',
    tags: ['Terraform', 'Kubernetes', 'AWS ECS', 'GitHub Actions'],
    code: '#OPS-411',
  },
  {
    slug: 'nexus-talent',
    title: 'Nexus Talent — Red Colaborativa para Especialistas Tech',
    description:
      'Plataforma de emparejamiento inteligente entre proyectos tecnológicos de alto impacto y consultores independientes verificados.',
    category: 'Desarrollo Web',
    tags: ['React', 'Node.js', 'MongoDB', 'WebSockets'],
    code: '#COMM-104',
  },
];

/** Categorías y tecnologías verbatim de Stitch (futura taxonomía WP). */
const CATEGORIES = [
  'Todas',
  'Desarrollo Web',
  'Aplicaciones Móviles',
  'Sistemas Empresariales',
  'APIs & Backend',
  'DevOps & Cloud',
];

const TECHNOLOGIES = [
  'Todas las tecnologías',
  'React / Next.js',
  'Node.js / Express',
  'PHP / CodeIgniter',
  'Python / FastAPI',
  'Flutter / iOS',
  'PostgreSQL / MySQL',
  'AWS / Docker',
];

const { locale, projects = DEFAULT_PROJECTS } = Astro.props;
const isEnglish = locale === 'en';
const home = getBreadcrumbHome(locale);

const copy = isEnglish
  ? {
      eyebrow: 'Portfolio & Case Studies',
      title: 'Our projects',
      description:
        'Explore the technology solutions, enterprise platforms, and digital products our community of freelance specialists has designed and built for clients across industries.',
      indexLabel: 'Projects',
      linkLabel: 'View project',
      metricCount: '+18',
      metricLabel: 'Successful deliveries',
      metricDescription:
        'Modular architectures, open-source standards, and engineering focused on measurable results without bureaucratic intermediaries.',
      searchPlaceholder: 'Search by name, client, or keyword...',
      techLabel: 'Filter by technology',
      sortLabel: 'Sort results',
      sortOptions: ['Most recent', 'Name (A - Z)', 'Name (Z - A)'],
      resultsOf: 'of 18 projects',
      showing: 'Showing',
      reset: 'Clear filters',
      pageOf: 'Page 1 of 3 (18 projects total)',
      paginationLabel: 'Projects pagination',
      prev: '← Previous',
      next: 'Next →',
      emptyTitle: 'No projects found',
      ctaTitle: 'Have a project in mind?',
      ctaDescription:
        'We connect your idea with qualified specialists who design and build tailored solutions. Robust architecture, scalable code, and verified periodic deliveries.',
      ctaPrimary: 'Start a conversation',
      ctaSecondary: 'Our process',
    }
  : {
      eyebrow: 'Portafolio & Casos de estudio',
      title: 'Nuestros proyectos',
      description:
        'Explora las soluciones tecnológicas, plataformas empresariales y productos digitales que nuestra comunidad de especialistas freelance ha diseñado y desarrollado para clientes en diversos sectores.',
      indexLabel: 'Proyectos',
      linkLabel: 'Ver proyecto',
      metricCount: '+18',
      metricLabel: 'Entregas con éxito',
      metricDescription:
        'Arquitecturas modulares, estándares de código abierto e ingeniería orientada a resultados medibles sin intermediarios burocráticos.',
      searchPlaceholder: 'Buscar por nombre, cliente o palabra clave...',
      techLabel: 'Filtrar por tecnología',
      sortLabel: 'Ordenar resultados',
      sortOptions: ['Más recientes', 'Nombre (A - Z)', 'Nombre (Z - A)'],
      resultsOf: 'de 18 proyectos',
      showing: 'Mostrando',
      reset: 'Limpiar filtros',
      pageOf: 'Página 1 de 3 (18 proyectos en total)',
      paginationLabel: 'Paginación de proyectos',
      prev: '← Anterior',
      next: 'Siguiente →',
      emptyTitle: 'No se encontraron proyectos',
      ctaTitle: '¿Tienes un proyecto en mente?',
      ctaDescription:
        'Conectamos tu idea con especialistas calificados que diseñan y construyen soluciones a tu medida. Arquitectura robusta, código escalable y entregas periódicas verificadas.',
      ctaPrimary: 'Iniciar una conversación',
      ctaSecondary: 'Conocer nuestro proceso',
    };

const pillActive =
  'text-label-bold bg-supporting-blue-dark text-brand-surface rounded-none px-3 py-1.5 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark';
const pillInactive =
  'text-label-bold bg-gw-surface-primary text-gw-text-secondary border-gw-border-subtle rounded-none border px-3 py-1.5 transition-colors duration-200 hover:bg-gw-surface-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark';
const fieldControl =
  'text-body-md text-gw-text-secondary border-gw-border-subtle bg-gw-surface-primary w-full rounded-none border px-3 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark';
const pageButton =
  'text-label-bold border-gw-border-subtle text-gw-text-secondary bg-gw-surface-primary rounded-none border px-3 transition-colors duration-200 hover:bg-gw-surface-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark';
---

<Section>
  <Breadcrumbs
    items={[{ label: home.label, href: home.href }, { label: copy.indexLabel }]}
    class="mb-8"
  />
  <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <div class="mb-4">
        <Badge class="border-brand-accent text-supporting-blue-dark border-l-2">
          {copy.eyebrow}
        </Badge>
      </div>
      <h1 class="text-gw-text-primary text-display-lg-mobile md:text-display-lg">
        {copy.title}
      </h1>
      <p class="text-gw-text-secondary text-body-lg mt-6 max-w-2xl">
        {copy.description}
      </p>
    </div>
    <div class="lg:col-span-4">
      <div class="bg-gw-surface-secondary border-supporting-blue-dark border-l-4 p-6">
        <p class="text-supporting-blue-dark flex items-baseline gap-2 font-bold">
          <span class="text-3xl tracking-tight">{copy.metricCount}</span>
          <span class="text-label-bold uppercase">{copy.metricLabel}</span>
        </p>
        <p class="text-gw-text-secondary text-body-md mt-2">
          {copy.metricDescription}
        </p>
      </div>
    </div>
  </div>
</Section>

<div class="bg-gw-surface-secondary border-gw-border-subtle sticky top-16 z-40 border-y py-6">
  <Container>
    <div class="space-y-5">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
        <div class="relative md:col-span-7">
          <Icon
            name="search"
            size={4}
            class="text-gw-text-secondary pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
          />
          <label class="sr-only" for="projects-search">
            {copy.searchPlaceholder}
          </label>
          <input
            id="projects-search"
            name="search"
            type="text"
            placeholder={copy.searchPlaceholder}
            class={`${fieldControl} pl-10`}
          />
        </div>
        <div class="md:col-span-3">
          <label class="sr-only" for="projects-tech">
            {copy.techLabel}
          </label>
          <select id="projects-tech" name="technology" class={fieldControl}>
            {TECHNOLOGIES.map((tech) => (
              <option value={tech}>{tech}</option>
            ))}
          </select>
        </div>
        <div class="md:col-span-2">
          <label class="sr-only" for="projects-sort">
            {copy.sortLabel}
          </label>
          <select id="projects-sort" name="sort" class={fieldControl}>
            {copy.sortOptions.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="flex flex-col gap-4 pt-2 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-wrap items-center gap-2" role="tablist">
          {CATEGORIES.map((category, index) => (
            <button
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              class={index === 0 ? pillActive : pillInactive}
            >
              {category}
            </button>
          ))}
        </div>
        <div class="flex items-center justify-between gap-5 lg:justify-end">
          <p class="text-navigation text-gw-text-secondary">
            {copy.showing}{' '}
            <strong class="text-supporting-blue-dark font-bold">
              {projects.length}
            </strong>{' '}
            {copy.resultsOf}
          </p>
          <button
            type="button"
            class="text-label-bold text-brand-secondary transition-colors duration-200 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark"
          >
            {copy.reset}
          </button>
        </div>
      </div>
    </div>
  </Container>
</div>

<Section>
  {projects.length > 0 ? (
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard
          badge={project.category}
          title={project.title}
          description={project.description}
          tags={project.tags}
          code={project.code}
          href={projectDetailUrl(locale, project.slug)}
          linkLabel={copy.linkLabel}
        />
      ))}
    </div>
  ) : (
    <SectionHeading title={copy.emptyTitle} align="center" />
  )}
  <div class="border-gw-border-subtle mt-16 flex flex-col items-center justify-between gap-6 border-t pt-10 md:flex-row">
    <p class="text-body-md text-gw-text-secondary order-2 md:order-1">
      {copy.pageOf}
    </p>
    <nav
      aria-label={copy.paginationLabel}
      class="order-1 flex items-center gap-1 md:order-2"
    >
      <span
        aria-disabled="true"
        class={`${pageButton} cursor-not-allowed py-2 opacity-50`}
      >
        {copy.prev}
      </span>
      <span
        aria-current="page"
        class="text-label-bold bg-supporting-blue-dark text-brand-surface flex h-10 w-10 items-center justify-center rounded-none"
      >
        1
      </span>
      <button type="button" class={`${pageButton} h-10 w-10`}>
        2
      </button>
      <button type="button" class={`${pageButton} h-10 w-10`}>
        3
      </button>
      <button type="button" class={`${pageButton} py-2`}>
        {copy.next}
      </button>
    </nav>
  </div>
</Section>

<Section class="bg-brand-primary text-brand-surface relative overflow-hidden">
  <div
    aria-hidden="true"
    class="bg-brand-secondary pointer-events-none absolute -right-12 -bottom-12 h-64 w-64 opacity-40"
  ></div>
  <div
    aria-hidden="true"
    class="bg-brand-accent pointer-events-none absolute top-8 right-32 h-24 w-24 opacity-30"
  ></div>
  <div class="relative z-10">
    <CTA
      tone="dark"
      align="left"
      eyebrow={copy.eyebrow}
      title={copy.ctaTitle}
      description={copy.ctaDescription}
      actions={[
        { label: copy.ctaPrimary, href: '/contact', variant: 'primary' },
        {
          label: copy.ctaSecondary,
          href: '/how-we-work',
          variant: 'outline-light',
        },
      ]}
    />
  </div>
</Section>
