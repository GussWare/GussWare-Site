---
/**
 * Final CTA del Home según Stitch `GussWare Home-V0.1.0`
 * (`GussWare Home - Complete Final Flow`).
 *
 * Bloque oscuro de ancho completo (`bg-brand-primary` =
 * `primary-container` de Stitch) con geometría decorativa en tokens
 * existentes, contenido a la izquierda mediante `CTA.astro`
 * (`tone="dark"`, `align="left"`, sin eyebrow) y gráfico modular de
 * bloques (`w-64 h-64`) a la derecha. Solo visualización.
 *
 * Consume `final_cta` de WordPress (`title`, `description`,
 * `button_text`, `button_url`, sin hardcodear): el botón solo se
 * renderiza con `button_text` no vacío (sin espacio reservado) y su
 * `href` es `button_url` tal cual.
 */
import Container from '../ui/Container.astro';
import CTA from '../ui/CTA.astro';
import Icon from '../ui/Icon.astro';
import type { WpFinalCta } from '../../lib/wordpress/types';

interface Props {
  finalCta: WpFinalCta;
}

const { finalCta } = Astro.props;

const hasButton = (finalCta.button_text ?? '').trim() !== '';
const actions = hasButton
  ? [{ label: finalCta.button_text, href: finalCta.button_url }]
  : [];
---

<section
  data-final-cta
  class="bg-brand-primary text-brand-surface relative overflow-hidden py-[var(--section-padding-mobile)] md:py-[var(--section-padding-desktop)]"
>
  <div
    aria-hidden="true"
    class="border-supporting-blue-fixed-dim pointer-events-none absolute -right-32 -bottom-32 h-96 w-96 rotate-45 border-[40px] opacity-20"
  ></div>
  <div
    aria-hidden="true"
    class="bg-gw-highlight pointer-events-none absolute top-1/4 right-1/4 h-1 w-32 opacity-50"
  ></div>
  <div
    aria-hidden="true"
    class="bg-brand-accent pointer-events-none absolute bottom-1/4 left-1/3 h-32 w-1 opacity-80"
  ></div>
  <Container>
    <div
      class="relative z-10 flex flex-col items-center justify-between gap-12 md:flex-row"
    >
      <div class="w-full max-w-3xl md:w-2/3">
        <CTA
          tone="dark"
          align="left"
          title={finalCta.title}
          description={finalCta.description}
          actions={actions}
        />
      </div>
      <div class="flex w-full justify-center md:w-1/3 md:justify-end">
        <div aria-hidden="true" class="relative h-64 w-64">
          <div
            class="bg-supporting-blue-fixed-dim absolute inset-0 translate-x-4 translate-y-4 opacity-20"
          ></div>
          <div
            class="border-brand-surface absolute inset-0 border-2 opacity-30"
          ></div>
          <div
            class="bg-brand-surface absolute top-0 left-0 h-1/2 w-1/2 opacity-10"
          ></div>
          <div
            class="bg-brand-accent absolute right-0 bottom-0 flex h-1/2 w-1/2 items-center justify-center opacity-80"
          >
            <Icon name="settings" size={10} />
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
