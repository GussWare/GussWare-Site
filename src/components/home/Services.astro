---
/**
 * Services del Home según Stitch `GussWare Home-V0.1.0`
 * (`GussWare Home - Complete Final Flow`, sección "Cómo te ayudamos").
 *
 * Intro en split (`services.title` en `display`, `services.description`
 * en `body-lg`; Stitch no usa eyebrow y no se renderiza aunque exista
 * en WordPress) y lista dinámica de `services.items[]` con numeración
 * derivada del índice (`01`, `02`, …), grid de 12 columnas en
 * desktop/tablet (número 2 + título 4 + descripción 5 + flecha 1),
 * apilado en mobile y hover `bg-gw-surface-secondary`.
 * Las filas NO son enlaces (el `#` de Stitch es solo referencia
 * visual): la flecha es un glifo decorativo sin navegación.
 * Todo el contenido llega de WordPress; sin hardcodear.
 */
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import type { WpServices, WpServiceItem } from '../../lib/wordpress/types';

interface Props {
  services: WpServices;
  /**
   * RGW-273 — Identificador de ancla de la sección (p. ej. el hash que
   * WordPress configura en el menú para este idioma). El nombre lo
   * define WordPress; Astro solo lo expone. Sin `id` no hay ancla.
   */
  id?: string;
}

const { services, id = undefined } = Astro.props;

const items: WpServiceItem[] = services.items ?? [];
const pad = (n: number): string => String(n).padStart(2, '0');
---

<Section id={id} class={id ? 'scroll-mt-24' : ''}>
  <div data-services>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6 mb-24 items-start">
      {services.title && (
        <div class="md:col-span-5">
          <h2
            class="text-gw-text-primary text-display-lg-mobile md:text-display-lg"
          >
            {services.title}
          </h2>
        </div>
      )}
      {services.description && (
        <div class="md:col-span-6 md:col-start-7 pt-2 md:pt-4">
          <p class="text-gw-text-secondary text-body-lg max-w-lg">
            {services.description}
          </p>
        </div>
      )}
    </div>
    {items.length > 0 && (
      <div data-services-list class="border-gw-border-subtle border-t">
        {items.map((item, index) => {
          // RGW-EP09-07-03: fila navegable cuando hay URL de detalle.
          const Tag = item.url ? 'a' : 'div';
          return (
            <Tag
              data-service-row
              href={item.url}
              class="group block border-gw-border-subtle border-b py-8 md:py-12 cursor-pointer transition-colors duration-300 hover:bg-gw-surface-secondary"
            >
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-center px-4 md:px-0">
                <div class="md:col-span-2">
                  <span class="text-gw-text-muted text-headline-md font-light">
                    {pad(index + 1)}
                  </span>
                </div>
                <div class="md:col-span-4">
                  <h3 class="text-gw-text-primary text-headline-lg transition-colors duration-300">
                    {item.title}
                  </h3>
                </div>
                <div class="md:col-span-5">
                  <p class="text-gw-text-secondary text-body-md">
                    {item.description}
                  </p>
                </div>
                <div class="md:col-span-1 flex justify-end items-center mt-4 md:mt-0">
                  <span aria-hidden="true" class="text-gw-text-muted">
                    <Icon name="arrow-right" size={8} />
                  </span>
                </div>
              </div>
            </Tag>
          );
        })}
      </div>
    )}
  </div>
</Section>
