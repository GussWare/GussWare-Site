---
/**
 * RGW-031 — Página de Contacto (estructura base).
 *
 * Utiliza `Layout` (Header + Footer existentes) y `ContactSection`
 * (sección de contacto compartida es/en sobre `Section`). El split reproduce el layout de
 * Stitch `GussWare Contact-V0.1.0`: apilado en mobile, dos columnas en
 * desktop (`lg:flex-row`, `gap-16`/`lg:gap-24`, mitades `lg:w-1/2`).
 * El contenido específico (info RGW-032, formulario RGW-033) se incorpora
 * en sus historias correspondientes.
 *
 * RGW-356 — El contenido de la sección se obtiene de la Page de WordPress
 * `contacto` (`acf.section_content`), no del endpoint `/gussware/v1/contact`
 * (que devuelve `contact_information: null`). El mapeo de redes sociales
 * usa `name`/`icon` (forma de la API) en lugar de `nombre`/`icono`.
 *
 * RGW-356/P-11 — `/contact/` y `/contacto/` sirven el mismo contenido en ES.
 * Los CTA globales (header y pie) apuntan a `/contacto/` como ruta canónica
 * (corregido en RGW-357).
 */

import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { getSocialMedia } from '../lib/wordpress/socialMedia';
import { getPageBySlug } from '../lib/wordpress/pages';
// RGW-271: configuración del formulario vía GET (Pavel Silinskii CF).
import {
  CONTACT_FORM_ID,
  getContactForm,
  getContactFormSubmitUrl,
} from '../lib/contact/forms';

const [socialMedia, contactForm, contactPage] = await Promise.all([
  getSocialMedia(),
  getContactForm(),
  getPageBySlug('contacto', Astro.currentLocale ?? 'es').catch(() => null),
]);

const contactFormSubmitUrl = getContactFormSubmitUrl(
  contactForm.id !== 'fallback' ? contactForm.id : CONTACT_FORM_ID,
);

const sectionContent = contactPage?.acf?.section_content ?? null;
---

<Layout
  title="Contact — GussWare"
  description="Contact GussWare — Start a conversation about your project."
>
  <ContactSection
    eyebrow={sectionContent?.eyebrow ?? undefined}
    title={sectionContent?.title ?? undefined}
    description={sectionContent?.description ?? undefined}
    socialText={sectionContent?.social_media_text ?? undefined}
    socialMedia={(socialMedia ?? []).map((social) => ({
      name: social.name,
      url: social.url,
      icon: social.icon,
    }))}
  >
    {/* RGW-271: campos dinámicos desde la API (mismo diseño). */}
    <ContactForm
      fields={contactForm.fields}
      submitUrl={contactFormSubmitUrl}
    />
  </ContactSection>
</Layout>
{/* RGW-271: la validación vive en `ContactForm` (sin POST todavía). */}
