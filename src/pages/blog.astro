---
/**
 * Página de Blog: listado real de WordPress.
 *
 * Utiliza `Layout` (Header + Footer existentes) y `Container`.
 * Hero según Stitch `GussWare Blog-V0.1.0` y barra de filtros/búsqueda.
 * La página 1 se renderiza en SSR con `getListPosts`; búsqueda, filtros y
 * paginación operan en el cliente contra la misma API (`wpRoutes`).
 */
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import {
  getCategories,
  getListPosts,
  normalizeBlogCard,
} from '../lib/wordpress/post';
import type { BlogCard } from '../lib/wordpress/types';

const PER_PAGE = 3;
const wpApiUrl = import.meta.env.WP_API_URL as string | undefined;

const [initialPosts, initialCategories] = await Promise.all([
  getListPosts(1, PER_PAGE, '', 'publish', 0, [], [], 'date', 'desc'),
  getCategories(),
]);

const catMap: Record<number, string> = {};
for (const category of initialCategories ?? []) {
  catMap[category.id] = category.name;
}

const initialCards: BlogCard[] = (initialPosts ?? []).map((post) =>
  normalizeBlogCard(post, catMap),
);
const initialError = initialPosts === null;

interface FeaturedMock {
  badge: string;
  readingTime: string;
  title: string;
  description: string;
  url: string;
}

// Mock local de la destacada (null = sin destacada, el bloque no se
// renderiza y no activa ningún estado; el listado sigue independiente).

const featuredPost: FeaturedMock | null = {
  badge: 'Technology',
  readingTime: '5 min read',
  title: 'The Future of Collaborative Development',
  description:
    'How distributed teams are shaping the next generation of digital products.',
  url: '#',
};
---

<Layout
  title="Blog — GussWare"
  description="GussWare blog and insights on technology and development."
>
  <header class="bg-gw-surface-secondary mb-12 py-16 md:py-24">
    <Container>
      <Breadcrumbs
        items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
        class="mb-4"
      />
      <h1 class="text-display-lg-mobile md:text-display-lg text-gw-text-primary">
        Blog & Insights
      </h1>
    </Container>
  </header>

  <div class="bg-gw-surface-auxiliary mb-16">
    <Container>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div
          id="blog-filters"
          class="flex flex-wrap items-center gap-2 md:gap-4"
        >
          <button
            type="button"
            data-cat-id="0"
            aria-pressed="true"
            class="text-label-bold bg-supporting-blue-dark text-brand-surface rounded-full px-6 py-2 transition-colors duration-200"
          >
            All
          </button>
          {(initialCategories ?? []).map((category) => (
            <button
              type="button"
              data-cat-id={category.id}
              aria-pressed="false"
              class="text-label-bold bg-gw-surface-secondary text-gw-text-secondary border-gw-border-subtle rounded-full border px-6 py-2 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight"
            >
              {category.name}
            </button>
          ))}
        </div>
        <div class="relative mt-4 w-full md:mt-0 md:w-72">
          <Icon
            name="search"
            size={4}
            class="text-gw-text-secondary absolute top-1/2 left-3 -translate-y-1/2"
          />
          <input
            id="blog-search"
            type="text"
            placeholder="Search articles..."
            aria-label="Search articles"
            class="text-body-md text-gw-text-secondary border-gw-border-subtle bg-gw-surface-primary w-full rounded-lg border py-2 pr-4 pl-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-supporting-blue-dark"
          />
        </div>
      </div>
    </Container>
  </div>

  {/* RGW-185: artículo destacado (maquetación con datos mock de Stitch; sin WordPress todavía). */}
  {featuredPost && (
    <div class="mb-30">
      <Container>
        <div class="bg-gw-surface-primary border-gw-border-subtle grid grid-cols-1 items-center gap-8 overflow-hidden rounded-none border md:grid-cols-2">
          <div class="relative h-64 w-full md:h-full md:min-h-96">
            <div
              aria-hidden="true"
              class="bg-gw-surface-secondary absolute inset-0 h-full w-full"
            ></div>
          </div>
          <div class="p-8 md:p-12">
            <div class="mb-4 flex items-center gap-4">
              <Badge>{featuredPost.badge}</Badge>
              <span class="text-body-md text-gw-text-secondary flex items-center gap-1">
                <Icon name="clock" size={4} />
                {featuredPost.readingTime}
              </span>
            </div>
            <h2 class="text-headline-lg text-gw-text-primary mb-4">
              {featuredPost.title}
            </h2>
            <p class="text-body-lg text-gw-text-secondary mb-8">
              {featuredPost.description}
            </p>
            <a
              href={featuredPost.url}
              class="text-label-bold text-supporting-blue-dark hover:text-brand-accent group inline-flex items-center gap-2 transition-colors duration-200"
            >
              Read Article
              <Icon
                name="arrow-right"
                size={4}
                class="transition-transform duration-200 group-hover:translate-x-1"
              />
            </a>
          </div>
        </div>
      </Container>
    </div>
  )}

  {/* Listado real de WordPress: página 1 en SSR, resto por fetch. */}
  <div class="mb-16">
    <Container>
      {!initialError && (
        <div
          id="blog-grid"
          class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3"
          data-wp-url={wpApiUrl ?? ''}
          data-per-page={String(PER_PAGE)}
          data-cats={JSON.stringify(catMap)}
          data-ids={JSON.stringify(initialCards.map((card) => card.id))}
        >
          {initialCards.map((card) => (
            <Card
              imageHeight="h-48"
              badge={card.badge ?? undefined}
              title={card.title}
              href={card.href}
            />
          ))}
          <div
            aria-hidden="true"
            class="skeleton-card bg-gw-surface-primary border-gw-border-subtle hidden overflow-hidden rounded-none border"
          >
            <div class="bg-gw-surface-secondary motion-safe:animate-pulse h-48 w-full"></div>
            <div class="flex flex-col p-6">
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-3 h-6 w-24 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-full rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-3/4 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mt-4 h-5 w-28 rounded-none"></div>
            </div>
          </div>
          <div
            aria-hidden="true"
            class="skeleton-card bg-gw-surface-primary border-gw-border-subtle hidden overflow-hidden rounded-none border"
          >
            <div class="bg-gw-surface-secondary motion-safe:animate-pulse h-48 w-full"></div>
            <div class="flex flex-col p-6">
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-3 h-6 w-24 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-full rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-3/4 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mt-4 h-5 w-28 rounded-none"></div>
            </div>
          </div>
          <div
            aria-hidden="true"
            class="skeleton-card bg-gw-surface-primary border-gw-border-subtle hidden overflow-hidden rounded-none border"
          >
            <div class="bg-gw-surface-secondary motion-safe:animate-pulse h-48 w-full"></div>
            <div class="flex flex-col p-6">
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-3 h-6 w-24 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-full rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mb-4 h-8 w-3/4 rounded-none"></div>
              <div class="bg-gw-surface-secondary motion-safe:animate-pulse mt-4 h-5 w-28 rounded-none"></div>
            </div>
          </div>
        </div>
      )}
      {!initialError && (
        <div id="load-more" class="mt-12 flex justify-center">
          <Button variant="secondary">Load More Articles</Button>
        </div>
      )}
      <div id="blog-empty" class="hidden py-8 text-center">
        <SectionHeading
          title="No articles found"
          description="Try adjusting your search or filter."
          align="center"
        />
      </div>
      <div
        id="blog-error"
        class={`py-8 text-center${initialError ? '' : ' hidden'}`}
        role="alert"
      >
        <SectionHeading
          title="Something went wrong"
          description="Please try again later."
          align="center"
        />
      </div>
    </Container>
  </div>
</Layout>

<script>
  import { fetchPostPage, normalizeBlogCard } from '../lib/wordpress/post';

  const grid = document.getElementById('blog-grid');
  const loadMore = document.getElementById('load-more');
  const emptyState = document.getElementById('blog-empty');
  const errorState = document.getElementById('blog-error');
  const searchInput = document.getElementById('blog-search');
  const filters = document.getElementById('blog-filters');

  const setVisible = (element, visible) => {
    if (element instanceof HTMLElement) {
      element.classList.toggle('hidden', !visible);
    }
  };

  const state = {
    page: 1,
    totalPages: 1,
    query: '',
    catId: 0,
    loading: false,
    perPage: 3,
    wpUrl: '',
    cats: {},
    renderedIds: new Set(),
  };

  if (grid instanceof HTMLElement) {
    state.wpUrl = (grid.dataset.wpUrl ?? '').replace(/\/+$/, '');
    state.perPage = Number(grid.dataset.perPage ?? '3') || 3;

    try {
      state.cats = JSON.parse(grid.dataset.cats ?? '{}');
    } catch {
      state.cats = {};
    }

    try {
      for (const id of JSON.parse(grid.dataset.ids ?? '[]')) {
        state.renderedIds.add(id);
      }
    } catch {
      // Sin ids iniciales: la protección de duplicados parte vacía.
    }
  }

  const pillActive =
    'text-label-bold bg-supporting-blue-dark text-brand-surface rounded-full px-6 py-2 transition-colors duration-200';
  const pillInactive =
    'text-label-bold bg-gw-surface-secondary text-gw-text-secondary border-gw-border-subtle rounded-full border px-6 py-2 transition-colors duration-200 hover:border-gw-highlight hover:bg-gw-highlight';

  // Nodos <article> reutilizables (única fuente visual: Card.astro).
  const cardPool = [];

  function bindCard(node, card) {
    const title = node.querySelector('h3');

    if (title) {
      title.textContent = card.title;
    }

    const badgeWrap = node.querySelector('div.mb-3');

    if (badgeWrap instanceof HTMLElement) {
      if (card.badge) {
        badgeWrap.classList.remove('hidden');

        const badgeText = badgeWrap.querySelector('span');

        if (badgeText) {
          badgeText.textContent = card.badge;
        }
      } else {
        badgeWrap.classList.add('hidden');
      }
    }

    const link = node.querySelector('a');

    if (link instanceof HTMLAnchorElement) {
      link.href = card.href;
    }
  }

  function setLoading(on) {
    if (!(grid instanceof HTMLElement)) {
      return;
    }

    grid.querySelectorAll('.skeleton-card').forEach((skeleton) => {
      if (skeleton instanceof HTMLElement) {
        skeleton.classList.toggle('hidden', !on);
      }
    });

    if (on) {
      grid.setAttribute('aria-busy', 'true');
    } else {
      grid.removeAttribute('aria-busy');
    }

    const button = loadMore?.querySelector('button');

    if (button instanceof HTMLButtonElement) {
      button.disabled = on;
    }
  }

  function updateLoadMore() {
    if (loadMore instanceof HTMLElement) {
      setVisible(loadMore, state.page < state.totalPages);
    }
  }

  function showContent() {
    setVisible(grid, true);
    setVisible(emptyState, false);
    setVisible(errorState, false);
    updateLoadMore();
  }

  function showEmpty() {
    setVisible(grid, false);
    setVisible(emptyState, true);
    setVisible(errorState, false);
    setVisible(loadMore, false);
  }

  function showError() {
    setVisible(grid, false);
    setVisible(emptyState, false);
    setVisible(loadMore, false);
    setVisible(errorState, true);
  }

  async function fetchPosts(page) {
    return fetchPostPage({
      baseUrl: state.wpUrl,
      page,
      perPage: state.perPage,
      query: state.query,
      catId: state.catId,
    });
  }

  function appendCards(items) {
    if (!(grid instanceof HTMLElement)) {
      return 0;
    }

    let added = 0;

    for (const item of items) {
      const card = normalizeBlogCard(item, state.cats);

      if (state.renderedIds.has(card.id)) {
        continue;
      }

      state.renderedIds.add(card.id);

      let node = cardPool.pop();

      if (!(node instanceof HTMLElement)) {
        const template = grid.querySelector('article');

        if (!(template instanceof HTMLElement)) {
          continue;
        }

        node = template.cloneNode(true);
      }

      bindCard(node, card);
      node.classList.remove('hidden');
      grid.appendChild(node);
      added += 1;
    }

    return added;
  }

  function clearCards() {
    grid?.querySelectorAll('article').forEach((card) => {
      if (card instanceof HTMLElement) {
        card.remove();
        cardPool.push(card);
      }
    });
    state.renderedIds.clear();
  }

  async function loadPosts({ reset }) {
    if (!(grid instanceof HTMLElement) || state.loading) {
      return;
    }

    if (!state.wpUrl) {
      showError();
      return;
    }

    state.loading = true;
    setLoading(true);
    setVisible(errorState, false);
    setVisible(emptyState, false);

    try {
      if (reset) {
        state.page = 1;
        clearCards();
      }

      const { items, totalPages } = await fetchPosts(state.page);
      state.totalPages = totalPages;
      appendCards(items);
      setLoading(false);

      if (grid.querySelectorAll('article').length === 0) {
        showEmpty();
      } else {
        showContent();
      }
    } catch {
      // Fuera de rango (página > 1): fin de datos, se conserva el contenido.
      // En primera página: error real.
      setLoading(false);

      if (state.page > 1) {
        state.page -= 1;
        showContent();
      } else {
        showError();
      }
    }

    state.loading = false;
  }

  loadMore?.addEventListener('click', () => {
    if (state.page >= state.totalPages) {
      updateLoadMore();
      return;
    }

    state.page += 1;
    loadPosts({ reset: false });
  });

  filters?.addEventListener('click', (event) => {
    const pill =
      event.target instanceof HTMLElement
        ? event.target.closest('button')
        : null;

    if (!(pill instanceof HTMLButtonElement)) {
      return;
    }

    state.catId = Number(pill.dataset.catId ?? '0') || 0;

    filters.querySelectorAll('button').forEach((other) => {
      const isActive = other === pill;
      other.className = isActive ? pillActive : pillInactive;
      other.setAttribute('aria-pressed', String(isActive));
    });

    loadPosts({ reset: true });
  });

  let searchTimer;

  searchInput?.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      const value =
        searchInput instanceof HTMLInputElement ? searchInput.value.trim() : '';

      if (value === state.query) {
        return;
      }

      state.query = value;
      loadPosts({ reset: true });
    }, 400);
  });
</script>
