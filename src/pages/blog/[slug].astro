---
/**
 * Detalle de artículo `/blog/[slug]` (Stitch `GussWare Blog-Article-V0.1.0`).
 *
 * Slugs desde WordPress (`getListPosts`); artículo por `slug` con
 * `getPostBySlug` (sin descargar todo para buscar local). Autor, tags e
 * imagen con rutas/tipos nativos. Estilos del contenido con tokens en
 * `<style>` acotado (el proyecto no tiene sistema de prosa).
 */
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Badge from '../../components/ui/Badge.astro';
import Icon from '../../components/ui/Icon.astro';
import Image from '../../components/ui/Image.astro';
import {
  getListPosts,
  getPostBySlug,
  getCategories,
  getTags,
  getUser,
} from '../../lib/wordpress/post';
import { wpFetch } from '../../lib/wordpress/client';
import { wpRoutes } from '../../lib/wordpress/routes';
import type { WpMedia } from '../../lib/wordpress/types';

export async function getStaticPaths() {
  const posts = await getListPosts(
    1,
    100,
    '',
    'publish',
    0,
    [],
    [],
    'date',
    'desc',
  );

  return (posts ?? []).map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post =
  typeof slug === 'string' ? await getPostBySlug(slug).catch(() => null) : null;

if (!post) {
  return Astro.redirect('/404');
}

const stripHtml = (html: string): string =>
  html
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const toReadingTime = (html: string): string => {
  const words = stripHtml(html).split(' ').filter(Boolean).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
};

const formatDate = (iso: string): string => {
  const date = new Date(iso);
  return Number.isNaN(date.getTime())
    ? iso
    : date.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });
};

const [author, allTags, categories] = await Promise.all([
  getUser(post.author).catch(() => null),
  getTags().catch(() => null),
  getCategories().catch(() => null),
]);

const categoryName =
  categories?.find((category) => category.id === post.categories?.[0])?.name ??
  null;
const tagNames = (allTags ?? []).filter((tag) => post.tags?.includes(tag.id));

let featuredImage: { src: string; alt: string } | null = null;

if (post.featured_media) {
  try {
    const media = await wpFetch<WpMedia>(wpRoutes.media(post.featured_media));

    if (media?.source_url) {
      featuredImage = {
        src: media.source_url,
        alt: media.alt_text || media.title?.rendered || post.title.rendered,
      };
    }
  } catch {
    // Sin imagen destacada: el artículo se renderiza igual.
  }
}

const title = stripHtml(post.title.rendered);
const description = stripHtml(post.excerpt.rendered).slice(0, 160);
const readingTime = toReadingTime(post.content.rendered);
const avatar =
  author?.avatar_urls?.['96'] ?? author?.avatar_urls?.['48'] ?? null;
---

<Layout title={`${title} — GussWare`} description={description}>
  <Container>
    <article class="mx-auto w-full max-w-[800px] pt-16 md:pt-24 pb-16 md:pb-24">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Blog', href: '/blog' },
          { label: categoryName ?? title },
        ]}
        class="mb-8"
      />
      <div class="mb-6 flex items-center gap-4">
        {categoryName && <Badge>{categoryName}</Badge>}
        <span class="text-body-md text-gw-text-secondary flex items-center gap-1">
          <Icon name="clock" size={4} />
          {readingTime}
        </span>
      </div>
      <h1 class="text-display-lg-mobile md:text-display-lg text-gw-text-primary mb-6">
        {title}
      </h1>
      <div class="mb-8 flex items-center gap-4">
        {avatar && (
          <img
            src={avatar}
            alt={author?.name ?? ''}
            width="48"
            height="48"
            loading="lazy"
            class="h-12 w-12 rounded-full object-cover"
          />
        )}
        <div class="flex flex-col">
          {author && (
            <span class="text-label-bold text-gw-text-primary">
              {author.name}
            </span>
          )}
          <span class="text-body-md text-gw-text-secondary">
            {formatDate(post.date)}
          </span>
        </div>
      </div>
      {featuredImage && (
        <figure class="mb-8">
          <Image
            src={featuredImage.src}
            alt={featuredImage.alt}
            class="h-auto w-full rounded-none"
          />
        </figure>
      )}
      <div class="article-content" set:html={post.content.rendered} />
      {tagNames.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {tagNames.map((tag) => (
            <Badge>{tag.name}</Badge>
          ))}
        </div>
      )}
    </article>
  </Container>
</Layout>

<style>
  .article-content {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-body-lg);
  }
  .article-content p {
    margin-bottom: var(--space-6);
  }
  .article-content h2 {
    font-size: var(--font-size-headline-md);
    font-weight: var(--font-weight-headline);
    line-height: var(--line-height-headline-md);
    color: var(--color-text-primary);
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
  }
  .article-content h3 {
    font-size: var(--font-size-headline-md);
    font-weight: var(--font-weight-headline);
    line-height: var(--line-height-headline-md);
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }
  .article-content ul,
  .article-content ol {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .article-content li {
    margin-bottom: var(--space-2);
  }
  .article-content a {
    color: var(--color-brand-secondary);
    text-decoration: underline;
  }
  .article-content a:hover {
    color: var(--color-brand-accent);
  }
  .article-content blockquote {
    border-left: 4px solid var(--color-brand-accent);
    padding-left: var(--space-6);
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
    font-style: italic;
    color: var(--color-text-primary);
  }
  .article-content pre {
    background-color: var(--color-text-primary);
    color: var(--color-surface-primary);
    padding: var(--space-6);
    overflow-x: auto;
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
    font-size: var(--font-size-body-md);
  }
  .article-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .article-content img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-none);
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
  }
  .article-content strong {
    font-weight: var(--font-weight-headline);
  }
</style>
