---
/**
 * Detalle de artículo por locale (`/en/blog/[slug]`, ...).
 *
 * Ruta fina: resuelve el artículo (`getBlogArticle`, con `lang`) y lo
 * renderiza con `BlogArticleView` (compartida con `/blog/[slug]`, sin
 * duplicar lógica). Sin artículo, redirige a `/404`.
 */
import Layout from '../../../layouts/Layout.astro';
import BlogArticleView from '../../../components/blog/BlogArticleView.astro';
import { getBlogArticle } from '../../../lib/wordpress/post';
import { routes } from '../../../lib/routes';

export const prerender = false;

const locale = Astro.params.locale ?? 'es';
const { slug } = Astro.params;
const data =
  typeof slug === 'string'
    ? await getBlogArticle(slug, locale, Astro.url.pathname).catch(() => null)
    : null;

if (!data) {
  return Astro.redirect(routes.notFound);
}
---

<Layout
  title={`${data.title} — GussWare`}
  description={data.description}
  localeUrls={data.localeUrls}
>
  <BlogArticleView locale={locale} {...data} />
</Layout>
