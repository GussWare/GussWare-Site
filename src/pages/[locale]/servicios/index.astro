---
/**
 * RGW-EP09-07-02 — Índice de servicios por locale (`/en/servicios`).
 *
 * Réplica de `servicios/index.astro` con `getFrontPage(locale)` y
 * `getServices(locale)`; cada tarjeta enlaza a su detalle localizado.
 * La imagen destacada de cada tarjeta sale de WordPress
 * (`featured_media` → `getServiceImage`, el mismo resolvedor que usa el
 * detalle): sin ella la tarjeta cae en el bloque de maquetación neutro.
 */
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Card from '../../../components/ui/Card.astro';
import { getFrontPage } from '../../../lib/wordpress/pages';
import {
  getServiceImage,
  getServices,
} from '../../../lib/wordpress/services';
import {
  servicesBaseUrl,
  serviceDetailUrl,
  getBreadcrumbHome,
} from '../../../lib/routes';
import { stripHtml } from '../../../lib/wordpress/text';

export const prerender = true;

/**
 * Rutas estáticas: solo el locale con prefijo de URL. El español lo
 * sirve `/servicios` (`servicios/index.astro`), sin prefijo.
 */
export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }];
}

const locale = Astro.params.locale ?? 'es';
const page = await getFrontPage(locale).catch(() => null);
const header = page?.acf?.services ?? null;
const services = await getServices(locale);
const home = getBreadcrumbHome(locale);

// Imagen destacada de cada servicio (WordPress `featured_media`).
const cards = await Promise.all(
  services.map(async (service) => ({
    service,
    image: await getServiceImage(service),
  })),
);

const localeUrls = {
  es: servicesBaseUrl('es'),
  en: servicesBaseUrl('en'),
};
---

<Layout
  title={`${header ? stripHtml(header.title) : 'Services'} — GussWare`}
  description={
    header ? stripHtml(header.description).slice(0, 160) : undefined
  }
  localeUrls={localeUrls}
  lang={page?.lang ?? locale}
>
  <Section>
    <Breadcrumbs
      items={[
        { label: home.label, href: home.href },
        { label: header ? stripHtml(header.title) : 'Services' },
      ]}
      class="mb-8"
    />
    {header && (
      <SectionHeading
        title={header.title}
        description={header.description}
      />
    )}
    {services.length > 0 && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
        {cards.map(({ service, image }) => (
          <Card
            image={image ?? undefined}
            title={stripHtml(service.title.rendered)}
            description={stripHtml(
              service.excerpt?.rendered || service.acf?.hero?.intro_description || '',
            )}
            href={serviceDetailUrl(locale, service.slug)}
          />
        ))}
      </div>
    )}
  </Section>
</Layout>
