---
/**
 * RGW-EP09-07-02 — Índice de servicios por locale (`/en/servicios`).
 *
 * Réplica de `servicios/index.astro` con `getPageBySlug(locale)` y
 * `getServices(locale)`; cada tarjeta enlaza a su detalle localizado.
 * La imagen destacada de cada tarjeta sale de WordPress
 * (`featured_media` → `getServiceImage`, el mismo resolvedor que usa el
 * detalle): sin ella la tarjeta cae en el bloque de maquetación neutro.
 *
 * SEO: obtiene metadatos de la página "Services" configurada en WordPress
 * con Yoast SEO.
 */
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/ui/Section.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Card from '../../../components/ui/Card.astro';
import { getPageBySlug } from '../../../lib/wordpress/pages';
import { getServiceImage, getServices } from '../../../lib/wordpress/services';
import {
  servicesBaseUrl,
  serviceDetailUrl,
  getBreadcrumbHome,
} from '../../../lib/routes';
import { stripHtml } from '../../../lib/wordpress/text';
import { buildSeoFromYoast } from '../../../lib/seo';

export const prerender = true;

/**
 * Rutas estáticas: solo el locale con prefijo de URL. El español lo
 * sirve `/servicios` (`servicios/index.astro`), sin prefijo.
 */
export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }];
}

const locale = Astro.params.locale ?? 'es';
const page = await getPageBySlug('servicios', locale).catch(() => null);
const services = await getServices(locale);
const home = getBreadcrumbHome(locale);

// Imagen destacada de cada servicio (WordPress `featured_media`).
const cards = await Promise.all(
  services.map(async (service) => ({
    service,
    image: await getServiceImage(service),
  })),
);

const localeUrls = {
  es: servicesBaseUrl('es'),
  en: servicesBaseUrl('en'),
};

// SEO: obtener metadatos desde la página de WordPress "Services"
const seoData = buildSeoFromYoast(page?.yoast_head_json);
---

<Layout
  title={seoData.title || `${locale === 'en' ? 'Services' : 'Servicios'} — GussWare`}
  description={seoData.description}
  localeUrls={localeUrls}
  lang={page?.lang ?? locale}
  {...(seoData.yoast
    ? {
        seo: {
          lang: page?.lang ?? locale,
          yoast: seoData.yoast,
          alternateUrls: localeUrls,
          languages: undefined,
        },
      }
    : {})}
>
  <Section>
    <Breadcrumbs
      items={[
        { label: home.label, href: home.href },
        { label: locale === 'en' ? 'Services' : 'Servicios' },
      ]}
      class="mb-8"
    />
    <SectionHeading title={locale === 'en' ? 'Services' : 'Servicios'} />
    {services.length > 0 && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
        {cards.map(({ service, image }) => (
          <Card
            image={image ?? undefined}
            title={stripHtml(service.title.rendered)}
            description={stripHtml(
              service.excerpt?.rendered ||
                service.acf?.hero?.intro_description ||
                '',
            )}
            href={serviceDetailUrl(locale, service.slug)}
          />
        ))}
      </div>
    )}
  </Section>
</Layout>