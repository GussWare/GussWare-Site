---
/**
 * Portada ES (`/`): renderiza la Page configurada como portada en
 * WordPress (`getFrontPage('es')`, con respaldo `inicio`) mediante el
 * render genérico (título + contenido). Sin contenido, conserva la
 * estructura mínima anterior. La contraparte EN es la raíz `/en/`
 * (convención i18n, sin conocimiento de la página concreta).
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Hero from '../components/home/Hero.astro';
import Expertise from '../components/home/Expertise.astro';
import CommunityModel from '../components/home/CommunityModel.astro';
import Services from '../components/home/Services.astro';
import Process from '../components/home/Process.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import type { LocaleUrls } from '../lib/routes';
import { getFrontPage } from '../lib/wordpress/pages';
import { wpFetch } from '../lib/wordpress/client';
import { wpRoutes } from '../lib/wordpress/routes';
import { stripHtml } from '../lib/wordpress/text';
import type { WpMedia } from '../lib/wordpress/types';

export const prerender = false;

const page = await getFrontPage('es').catch(() => null);

const localeUrls: LocaleUrls = {
  es: Astro.url.pathname,
  en: getRelativeLocaleUrl('en', '/'),
};

const title = page ? stripHtml(page.title.rendered) : 'GussWare';
const description = page
  ? stripHtml(page.excerpt.rendered).slice(0, 160)
  : undefined;
const hero = page?.acf?.hero ?? null;
const expertise = page?.acf?.expertise ?? null;
const technology = page?.acf?.technology ?? null;
const services = page?.acf?.services ?? null;
const process = page?.acf?.process ?? null;
const finalCta = page?.acf?.final_cta ?? null;
const faq = page?.acf?.faq ?? null;

const heroImageId = hero?.image ?? null;
let heroImage: { src: string; alt: string } | null = null;

if (heroImageId) {
  try {
    const media = await wpFetch<WpMedia>(wpRoutes.media(heroImageId));

    if (media?.source_url) {
      heroImage = {
        src: media.source_url,
        alt:
          media.alt_text ||
          media.title?.rendered ||
          stripHtml(page?.title?.rendered ?? ''),
      };
    }
  } catch {
    // Sin imagen: el Hero se renderiza sin bloque visual.
  }
}

const stepImages = await Promise.all(
  (process?.steps ?? []).map(async (step) => {
    if (!step.image) return null;
    try {
      const media = await wpFetch<WpMedia>(wpRoutes.media(step.image));

      if (media?.source_url) {
        return {
          src: media.source_url,
          alt: media.alt_text || step.title,
        };
      }
    } catch {
      // Sin imagen: el paso se renderiza con bloque neutro.
    }
    return null;
  }),
);
---

<Layout
  title={page ? `${title} — GussWare` : 'GussWare — Design System'}
  description={description}
  localeUrls={localeUrls}
>
  {page && hero ? (
    <>
      <Hero hero={hero} image={heroImage} />
      {expertise && <Expertise expertise={expertise} />}
      {technology && <CommunityModel technology={technology} />}
      {services && <Services services={services} />}
      {process && <Process process={process} images={stepImages} />}
      {faq && <Faq faq={faq} />}
      {finalCta && <FinalCta finalCta={finalCta} />}
    </>
  ) : (
    page && (
      <Container>
        <article class="mx-auto w-full max-w-[800px] pt-16 md:pt-24 pb-16 md:pb-24">
          <h1 class="text-display-lg-mobile md:text-display-lg text-gw-text-primary mb-6">
            {title}
          </h1>
          <div set:html={page.content.rendered} />
        </article>
      </Container>
    )
  )}
</Layout>
