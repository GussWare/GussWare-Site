---
/**
 * RGW-EP09-07-01 — Índice de servicios ES (`/servicios`).
 *
 * Encabezado desde `Home.acf.services` (título/descripción); tarjetas
 * desde el CPT `service` (`getServices('es')`) con enlace al detalle.
 * Sin contenido hardcodeado.
 *
 * La imagen destacada de cada tarjeta sale de WordPress
 * (`featured_media` → `getServiceImage`, el mismo resolvedor que usa el
 * detalle): sin ella la tarjeta cae en el bloque de maquetación neutro.
 */
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import { getFrontPage } from '../../lib/wordpress/pages';
import { getServiceImage, getServices } from '../../lib/wordpress/services';
import {
  routes,
  servicesBaseUrl,
  serviceDetailUrl,
} from '../../lib/routes';
import { stripHtml } from '../../lib/wordpress/text';

export const prerender = true;

const page = await getFrontPage('es').catch(() => null);
const header = page?.acf?.services ?? null;
const services = await getServices('es');

// Imagen destacada de cada servicio (WordPress `featured_media`).
const cards = await Promise.all(
  services.map(async (service) => ({
    service,
    image: await getServiceImage(service),
  })),
);

const localeUrls = {
  es: servicesBaseUrl('es'),
  en: servicesBaseUrl('en'),
};
---

<Layout
  title={`Servicios — GussWare`}
  description={
    header ? stripHtml(header.description).slice(0, 160) : undefined
  }
  localeUrls={localeUrls}
>
  <Section>
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: routes.home },
        { label: 'Servicios' },
      ]}
      class="mb-8"
    />
    {header && (
      <SectionHeading
        title={header.title}
        description={header.description}
      />
    )}
    {services.length > 0 && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
        {cards.map(({ service, image }) => (
          <Card
            image={image ?? undefined}
            title={stripHtml(service.title.rendered)}
            description={stripHtml(
              service.excerpt?.rendered || service.acf?.hero?.intro_description || '',
            )}
            href={serviceDetailUrl('es', service.slug)}
          />
        ))}
      </div>
    )}
  </Section>
</Layout>
