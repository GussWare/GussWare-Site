---
/**
 * RGW-EP09-07-01 — Índice de servicios ES (`/servicios`).
 *
 * Encabezado desde `Home.acf.services` (título/descripción); tarjetas
 * desde el CPT `service` (`getServices('es')`) con enlace al detalle.
 * Sin contenido hardcodeado.
 *
 * La imagen destacada de cada tarjeta sale de WordPress
 * (`featured_media` → `getServiceImage`, el mismo resolvedor que usa el
 * detalle): sin ella la tarjeta cae en el bloque de maquetación neutro.
 *
 * SEO: obtiene metadatos de la página "Servicios" configurada en WordPress
 * con Yoast SEO.
 */
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import { getPageBySlug } from '../../lib/wordpress/pages';
import { getServiceImage, getServices } from '../../lib/wordpress/services';
import { routes, servicesBaseUrl, serviceDetailUrl } from '../../lib/routes';
import { stripHtml } from '../../lib/wordpress/text';
import { buildSeoFromYoast } from '../../lib/seo';

export const prerender = true;

const page = await getPageBySlug('servicios', 'es').catch(() => null);
const services = await getServices('es');

// Imagen destacada de cada servicio (WordPress `featured_media`).
const cards = await Promise.all(
  services.map(async (service) => ({
    service,
    image: await getServiceImage(service),
  })),
);

const localeUrls = {
  es: servicesBaseUrl('es'),
  en: servicesBaseUrl('en'),
};

// SEO: obtener metadatos desde la página de WordPress "Servicios"
const seoData = buildSeoFromYoast(page?.yoast_head_json);
---

<Layout
  title={seoData.title || 'Servicios — GussWare'}
  description={seoData.description}
  localeUrls={localeUrls}
  lang="es"
  {...(seoData.yoast
    ? {
        seo: {
          lang: 'es',
          yoast: seoData.yoast,
          alternateUrls: localeUrls,
          languages: undefined,
        },
      }
    : {})}
>
  <Section>
    <Breadcrumbs
      items={[{ label: 'Inicio', href: routes.home }, { label: 'Servicios' }]}
      class="mb-8"
    />
    <SectionHeading title="Servicios" />
    {services.length > 0 && (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
        {cards.map(({ service, image }) => (
          <Card
            image={image ?? undefined}
            title={stripHtml(service.title.rendered)}
            description={stripHtml(
              service.excerpt?.rendered ||
                service.acf?.hero?.intro_description ||
                '',
            )}
            href={serviceDetailUrl('es', service.slug)}
          />
        ))}
      </div>
    )}
  </Section>
</Layout>