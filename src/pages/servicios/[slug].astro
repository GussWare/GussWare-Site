---
/**
 * RGW-EP09-06-01 — Detalle de servicio ES (`/servicios/[slug]`).
 *
 * Ruta fina: resuelve el servicio (`getServiceBySlug`, `lang=es`) y lo
 * renderiza con `ServiceDetail` (compartido con `[locale]`, sin duplicar
 * lógica). Sin servicio, redirige a `/404`.
 */
import Layout from '../../layouts/Layout.astro';
import ServiceDetail from '../../components/services/ServiceDetail.astro';
import {
  getServiceBySlug,
  getServiceImage,
} from '../../lib/wordpress/services';
import { wpFetch } from '../../lib/wordpress/client';
import { wpRoutes } from '../../lib/wordpress/routes';
import {
  routes,
  servicesBaseUrl,
  serviceDetailUrl,
} from '../../lib/routes';
import { stripHtml } from '../../lib/wordpress/text';
import type { WpService } from '../../lib/wordpress/types';

export const prerender = false;

const { slug } = Astro.params;
const service =
  typeof slug === 'string'
    ? await getServiceBySlug(slug, 'es').catch(() => null)
    : null;

if (!service) {
  return Astro.redirect(routes.notFound);
}

const image = await getServiceImage(service);

let enSlug = service.slug;
const enId = service.translations?.en;

if (typeof enId === 'number' && enId !== service.id) {
  const translated = await wpFetch<WpService>(wpRoutes.service(enId)).catch(
    () => null,
  );

  if (translated?.slug) {
    enSlug = translated.slug;
  }
}

const localeUrls = {
  es: serviceDetailUrl('es', service.slug),
  en: serviceDetailUrl('en', enSlug),
};
---

<Layout
  title={`${stripHtml(service.title.rendered)} — GussWare`}
  description={stripHtml(service.excerpt.rendered).slice(0, 160) || undefined}
  localeUrls={localeUrls}
  lang={service.lang}
>
  <ServiceDetail
    service={service}
    image={image}
    locale="es"
    indexUrl={servicesBaseUrl('es')}
    indexLabel="Servicios"
  />
</Layout>
