# Entorno Local / DEV — PLANTILLA.
#
# Copia estructural de `.env`: mismas variables, mismos comentarios y
# valores de ejemplo o vacíos. Este archivo SÍ se versiona; `.env`,
# `.env.staging` y `.env.production` no.
#
# Uso: `cp .env.example .env` y completa las credenciales.
#
# Este archivo lo carga Astro/Vite en TODOS los modos (`astro dev`,
# `astro build --mode staging`, `astro build --mode production`). Por eso
# aquí solo viven las variables comunes (URLs de Local/DEV y credenciales)
# y las URLs propias de staging y producción están en `.env.staging` y
# `.env.production`, que tienen prioridad sobre este archivo en su modo.

# URL base del CMS WordPress headless (sin `/wp-json`).
WORDPRESS_URL=http://gussware.local

# URL pública del sitio (sitemap, canonical, robots).
SITE_URL=http://localhost:4321

# Credenciales de la aplicación de WordPress (Basic Auth).
# Necesarias para los endpoints restringidos `/wp/v2/settings` (logo del
# header, favicon y URL del sitio en los textos legales).
# Si faltan, el build no falla, pero el sitio se genera sin logo ni
# favicon y con las etiquetas legales sin sustituir.
POSTMAN_APP_USERNAME=""
POSTMAN_APP_PASSWORD=""

# Verificación del CMS durante el build:
#   `true`  (por defecto) el build FALLA si WordPress no responde o no
#           entrega servicios/páginas publicados.
#   `false` degrada ese fallo a advertencia. Solo para builds offline:
#           nunca en CI ni en un despliegue.
WP_BUILD_STRICT="true"

# Token de acceso al MCP de WordPress (herramienta externa; el build de
# Astro no lo utiliza).
MCP_TOKEN=""
MCP_TOKEN_BASE64=""
MCP_TOKEN_BASIC_AUTH=""
